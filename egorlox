--// TOGGLE FUNCTION
local function ToggleMenu()
    CFG.IsOpen = not CFG.IsOpen
    if CFG.IsOpen then
        Tween(Menu, {Position = UDim2.new(0.5, -CFG.Width/2, 0.5, -CFG.Height/2)}, CFG.AnimSpeed, Enum.EasingStyle.Back)
        Tween(WatermarkFrame, {BackgroundTransparency = 0.05}, 0.3)
    else
        Tween(Menu, {Position = UDim2.new(0.5, -CFG.Width/2, 0, -CFG.Height - 60)}, CFG.AnimSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Tween(WatermarkFrame, {BackgroundTransparency = 0.15}, 0.3)
    end
end

