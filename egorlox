local function ripple(btn)
    local r = Instance.new("Frame", btn)
    r.Size                  = UDim2.new(0, 0, 0, 0)
    r.Position              = UDim2.new(0.5, 0, 0.5, 0)
    r.BackgroundColor3      = Color3.fromRGB(255, 255, 255)
    r.BackgroundTransparency= 0.65
    r.BorderSizePixel       = 0
    r.ZIndex                = btn.ZIndex + 5
    Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)

    local mx = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
    local tw = TweenService:Create(r, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size     = UDim2.new(0, mx, 0, mx),
        Position = UDim2.new(0.5, -mx/2, 0.5, -mx/2),
        BackgroundTransparency = 1,
    })
    tw:Play()
    tw.Completed:Connect(function() r:Destroy() end)
end

