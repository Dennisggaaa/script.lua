    State.Tab = name

    for tabName, data in pairs(TabButtons) do
        local active = tabName == name
        tween(data.Button, 0.18, {
            BackgroundColor3 = active and Theme.CardActive or Theme.Card,
            BackgroundTransparency = active and 0.02 or 0.4,
