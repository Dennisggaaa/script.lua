-- Эффект при нажатии на ватермарк (Открытие/Закрытие)
local isOpen = true

local function toggleMenu()
    isOpen = not isOpen
    local goalSize = isOpen and UDim2.new(0, 780, 0, 460) or UDim2.new(0, 780, 0, 0)
    local goalTransp = isOpen and 0 or 1
    
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = goalSize}):Play()
    TweenService:Create(MainFrame.UIStroke, TweenInfo.new(0.4), {Transparency = goalTransp}):Play()
    
    for _, obj in pairs(MainFrame:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("Frame") or obj:IsA("UIStroke") then
            if obj.Name ~= "MainFrameStroke" then
                TweenService:Create(obj, TweenInfo.new(0.2), {BackgroundTransparency = isOpen and (obj.Name == "ContentBg" and 0 or (obj:IsA("Frame") and 0 or 1)) or 1, TextTransparency = goalTransp}):Play()
            end
        end
    end
end

Watermark.MouseButton1Click:Connect(toggleMenu)

