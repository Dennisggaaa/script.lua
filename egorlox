local ParticleSystem = {}

function ParticleSystem:CreateParticle(parent, x, y, size, color, speed, lifespan, shape, glow)
    local particle = Instance.new("Frame")
    particle.Size = UDim2.new(0, size or 4, 0, size or 4)
    particle.Position = UDim2.new(0, x, 0, y)
    particle.BackgroundColor3 = color or C.Primary
    particle.BorderSizePixel = 0
    particle.BackgroundTransparency = 0.2
    particle.ZIndex = 150
    particle.Parent = parent
    
    if glow then
        local glowFrame = Instance.new("Frame")
        glowFrame.Size = UDim2.new(1, 15, 1, 15)
        glowFrame.Position = UDim2.new(0.5, -7.5, 0.5, -7.5)
        glowFrame.BackgroundColor3 = color or C.Primary
        glowFrame.BackgroundTransparency = 0.85
        glowFrame.BorderSizePixel = 0
        glowFrame.ZIndex = -1
        glowFrame.Parent = particle
        CreateRoundedCorner(glowFrame, 20)
    end
    
    if shape == "circle" or not shape then
        CreateRoundedCorner(particle, size / 2)
    else
        particle.Rotation = math.random(0, 360)
    end

    spawn(function()
        local startTime = tick()
        local life = lifespan or (2 + math.random() * 5)
        local speedX = (math.random() - 0.5) * (speed or 35)
        local speedY = (math.random() - 0.5) * (speed or 35) - 20
        local startX = x
        local startY = y
        local rotSpeed = (math.random() - 0.5) * 180
        while tick() - startTime < life and particle.Parent do
            local elapsed = tick() - startTime
            local progress = elapsed / life
            particle.Position = UDim2.new(0, startX + speedX * elapsed + math.sin(elapsed * 3) * 25, 0, startY + speedY * elapsed + 80 * progress * progress)
            particle.BackgroundTransparency = 0.2 + progress * 0.8
            particle.Size = UDim2.new(0, size * (1 - progress * 0.5), 0, size * (1 - progress * 0.5))
            particle.Rotation = particle.Rotation + rotSpeed * 0.03
            if glow and particle.Children then
                for _, child in ipairs(particle:GetChildren()) do
                    if child:IsA("Frame") then
                        child.BackgroundTransparency = 0.85 + progress * 0.15
                        child.Size = UDim2.new(1, 15 + 15 * progress, 1, 15 + 15 * progress)
                    end
                end
            end
            wait(0.02)
        end
        pcall(function() particle:Destroy() end)
    end)
    return particle
end

function ParticleSystem:Burst(parent, count, x, y, colors, sizeRange, speed, lifespan, glow)
    for i = 1, count do
        local size = math.random(sizeRange[1] or 2, sizeRange[2] or 10)
        local color = colors[math.random(1, #colors)]
        local angle = math.random() * math.pi * 2
        local dist = math.random(5, 100)
        local px = x + math.cos(angle) * dist
        local py = y + math.sin(angle) * dist
        ParticleSystem:CreateParticle(parent, px, py, size, color, speed or 25, lifespan or 4, nil, glow)
    end
end

