    fill.BackgroundColor3=CFG.Accent; fill.ZIndex=26; fill.Parent=track; Corner(fill,3)
    local fg=Instance.new("UIGradient"); fg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromHex("#4A55CC")),
        ColorSequenceKeypoint.new(1,CFG.AccentLt),
