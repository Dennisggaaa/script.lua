    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = getAccent()
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.Parent = track
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(16, 16)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Parent = track
    corner(knob, 8)

    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Size = UDim2.new(1, 0, 0, 30)
    hit.Position = UDim2.fromOffset(0, 36)
    hit.Parent = row

    local value = math.clamp(initial or min, min, max)
    local dragging = false

    local function setValue(v, fire)
        value = math.clamp(math.floor(v + 0.5), min, max)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        if fire and callback then callback(value) end
    end

    local function fromX(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1),
            0,
            1
        )
        setValue(min + (max - min) * alpha, true)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            fromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    setValue(value, false)

    return {
        Row = row,
        Set = function(v)
            setValue(v, false)
        end,
        Get = function()
            return value
        end,
    }
end

--// DROPDOWN
local function createDropdown(parent, titleText, subtitleText, options, initial, callback)
    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(1, 0, 0, 64)
    holder.ClipsDescendants = true
    holder.Parent = parent

    local main = buttonBase(holder)
    main.Position = UDim2.fromOffset(0, 0)
    main.Size = UDim2.new(1, 0, 0, 52)
    main.BackgroundColor3 = Theme.Background

    local titleLabel = text(main, titleText, 12, Theme.Text, Enum.Font.GothamMedium)
    titleLabel.Position = UDim2.fromOffset(12, 3)
    titleLabel.Size = UDim2.new(0.55, 0, 0, 22)

    local sub = text(main, subtitleText or "", 9, Theme.Muted, Enum.Font.Gotham)
    sub.Position = UDim2.fromOffset(12, 25)
    sub.Size = UDim2.new(0.55, 0, 0, 18)

    local selected = initial or options[1]
    local valueLabel = text(main, tostring(selected), 11, getAccent(), Enum.Font.GothamMedium)
    valueLabel.AnchorPoint = Vector2.new(1, 0)
    valueLabel.Position = UDim2.new(1, -30, 0, 0)
    valueLabel.Size = UDim2.fromOffset(110, 52)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local arrow = text(main, "⌄", 17, Theme.Secondary, Enum.Font.Gotham)
    arrow.AnchorPoint = Vector2.new(1, 0)
    arrow.Position = UDim2.new(1, -10, 0, 0)
    arrow.Size = UDim2.fromOffset(18, 52)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local optionsFrame = Instance.new("Frame")
    optionsFrame.BackgroundColor3 = Theme.Card
    optionsFrame.BorderSizePixel = 0
    optionsFrame.Position = UDim2.fromOffset(0, 58)
    optionsFrame.Size = UDim2.new(1, 0, 0, #options * 38)
    optionsFrame.Visible = false
    optionsFrame.Parent = holder
    corner(optionsFrame, 12)
    stroke(optionsFrame, Theme.Border, 0.2, 1)

    local list = Instance.new("UIListLayout")
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = optionsFrame

    local opened = false

    local function close()
        opened = false
        optionsFrame.Visible = false
        holder.Size = UDim2.new(1, 0, 0, 64)
        arrow.Text = "⌄"
    end

    for i, option in ipairs(options) do
        local optionButton = buttonBase(optionsFrame)
        optionButton.Size = UDim2.new(1, 0, 0, 38)
        optionButton.BackgroundTransparency = 1

        local optionText = text(optionButton, tostring(option), 11, Theme.Secondary, Enum.Font.Gotham)
        optionText.Position = UDim2.fromOffset(12, 0)
        optionText.Size = UDim2.new(1, -24, 1, 0)

        optionButton.Activated:Connect(function()
            selected = option
            valueLabel.Text = tostring(selected)
            if callback then callback(selected) end
            close()
        end)
    end

    main.Activated:Connect(function()
        opened = not opened
        if opened then
            optionsFrame.Visible = true
            holder.Size = UDim2.new(1, 0, 0, 64 + optionsFrame.Size.Y.Offset + 6)
            arrow.Text = "⌃"
        else
            close()
        end
    end)

    return {
        Holder = holder,
        Set = function(v)
            selected = v
            valueLabel.Text = tostring(v)
        end,
        Get = function()
            return selected
        end,
    }
end

