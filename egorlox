CreateTab("Settings")
Tabs["Settings"].Render = function()
    CreateCategory(PageContainer, "Visuals")
    local isPulsing = false
    CreateToggle(PageContainer, "Pulse Effect", "UI white glow.", false, function(state)
        isPulsing = state
        if state then
            task.spawn(function()
                while isPulsing do
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255)}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255)}):Play()
                    task.wait(0.8)
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Theme.Stroke}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.8}):Play()
                    task.wait(0.8)
                end
            end)
        else
            TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Theme.Stroke}):Play()
            TweenService:Create(WmStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.8}):Play()
        end
    end)
    CreateColorSlider(PageContainer, "Accent Color", "UI Color.", Theme.Accent, function(color)
        if not isPulsing then
            Theme.Accent = color PageContainer.ScrollBarImageColor3 = color FovStroke.Color = color
            for name, tab in pairs(Tabs) do if name == ActiveTab then tab.Button.Title.TextColor3 = color SlideIndicator.BackgroundColor3 = color end end
        end
    end)
end

