local function ApplyAccent(col)
    CFG.Accent = col
    if LIVE.MenuStroke then Tw(LIVE.MenuStroke, { Color = col }, 0.2):Play() end
    for _, e in ipairs(LIVE.Accents) do
        pcall(function() Tw(e.o, { [e.p] = col }, 0.2):Play() end)
    end
    for _, t in ipairs(LIVE.Tabs) do
        if t.active then Tw(t.btn, { BackgroundColor3 = col }, 0.2):Play() end
    end
end
local function ApplyWM(col)
    CFG.WMColor = col
    Tw(LIVE.WM.Stroke, { Color = col }, 0.2):Play()
    Tw(LIVE.WM.Dot, { BackgroundColor3 = col }, 0.2):Play()
end

