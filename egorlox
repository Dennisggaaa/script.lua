local espObjects = {}

local function createEspForPlayer(player)
    if espObjects[player] then return espObjects[player] end
    local highlight = Instance.new("Highlight")
    highlight.Name = "Chams_" .. player.Name
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(0, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = nil
    espObjects[player] = { highlight = highlight }
    return espObjects[player]
end

local function removeEspForPlayer(player)
    local data = espObjects[player]
    if data and data.highlight then
        data.highlight:Destroy()
        espObjects[player] = nil
    end
end

local function updateEspForPlayer(player)
    local data = espObjects[player]
    if not data then return end

    local role = playerRoles[player]
    
    if role ~= "Murderer" and role ~= "Sheriff" then
        local detectedRole = detectRole(player)
        if detectedRole == "Murderer" or detectedRole == "Sheriff" then
            playerRoles[player] = detectedRole
            role = detectedRole
        else
            role = "Innocent"
        end
    end

    local shouldHighlight = false
    local color = Color3.new(1, 1, 1)

    if role == "Murderer" and espState.chamsMurder then
        shouldHighlight = true
        color = Color3.fromRGB(255, 0, 64)
    elseif role == "Sheriff" and espState.chamsSherif then
        shouldHighlight = true
        color = Color3.fromRGB(0, 170, 255)
    elseif role == "Innocent" and espState.chamsEnemies then
        shouldHighlight = true
        color = Color3.fromRGB(0, 255, 0)
    end

    if shouldHighlight then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if data.highlight.Parent ~= player.Character then
                data.highlight.Parent = player.Character
            end
            data.highlight.Enabled = true
            data.highlight.FillColor = color
        else
            data.highlight.Enabled = false
        end
    else
        data.highlight.Enabled = false
    end
end

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espObjects[player] then createEspForPlayer(player) end
            updateEspForPlayer(player)
        end
    end
    for player, _ in pairs(espObjects) do
        if not Players:FindFirstChild(player.Name) then removeEspForPlayer(player) end
    end
end)

Players.PlayerRemoving:Connect(removeEspForPlayer)

-- WALLSHOT HOOK
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    if mmState.wallShot or mmState.forceTarget then
        if method == "FireServer" and self:IsA("Tool") then
            local toolName = self.Name:lower()
            if toolName:find("gun") or toolName:find("revolver") or toolName:find("pistol") or toolName:find("colt") then
                local targetPart = mmState.forceTarget
                if not targetPart then
                    local closestPart, closestDist = nil, math.huge
                    local camera = workspace.CurrentCamera
                    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                    
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local char = plr.Character
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                for _, partName in ipairs({"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}) do
                                    local part = char:FindFirstChild(partName)
                                    if part then
                                        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                                        if onScreen then
                                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                            if dist < closestDist then
                                                closestDist = dist
                                                closestPart = part
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    targetPart = closestPart
                end
                
                if targetPart then
                    local args = {...}
                    for i = 1, #args do
                        if typeof(args[i]) == "Instance" and args[i]:IsA("BasePart") then
                            args[i] = targetPart
                        elseif typeof(args[i]) == "Vector3" then
                            args[i] = targetPart.Position
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        elseif self == workspace and mmState.wallShot then
            if method == "Raycast" then
                local args = {...}
                local origin = args[1]
                local direction = args[2]
                local params = args[3] or RaycastParams.new()
                
                local newParams = RaycastParams.new()
                newParams.FilterType = Enum.RaycastFilterType.Exclude
                local filter = {}
                if params.FilterDescendantsInstances then
                    for _, v in ipairs(params.FilterDescendantsInstances) do table.insert(filter, v) end
                end
                if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
                newParams.FilterDescendantsInstances = filter
                
                local currentOrigin = origin
                local remainingDir = direction
                
                for i = 1, 15 do
                    local result = oldNamecall(self, currentOrigin, remainingDir, newParams)
                    if not result then return nil end
                    local model = result.Instance:FindFirstAncestorOfClass("Model")
                    if model and model:FindFirstChildOfClass("Humanoid") then
                        return result
                    else
                        table.insert(filter, result.Instance)
                        currentOrigin = result.Position
                        remainingDir = origin + direction - currentOrigin
                        if remainingDir.Magnitude < 0.1 then return nil end
                    end
                end
                return oldNamecall(self, origin, direction, params)
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                local args = {...}
                local ray = args[1]
                local ignoreList = args[2] or {}
                if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
                
                local currentOrigin = ray.Origin
                local remainingDir = ray.Direction
                
                for i = 1, 15 do
                    local newRay = Ray.new(currentOrigin, remainingDir)
                    local part, pos, normal
                    if method == "FindPartOnRay" then
                        part, pos, normal = oldNamecall(self, newRay)
                    else
                        part, pos, normal = oldNamecall(self, newRay, ignoreList)
                    end
                    
                    if not part then return nil end
                    
                    local model = part:FindFirstAncestorOfClass("Model")
                    if model and model:FindFirstChildOfClass("Humanoid") then
                        return part, pos, normal
                    else
                        table.insert(ignoreList, part)
                        currentOrigin = pos
                        remainingDir = ray.Origin + ray.Direction - currentOrigin
                        if remainingDir.Magnitude < 0.1 then return nil end
                    end
                end
                return oldNamecall(self, ...)
            end
        end
    end
    return oldNamecall(self, ...)
end
setreadonly(mt, true)

-- ANTI-FLING LOGIC
local antiFlingLoop
local function ApplyAntiFling(state)
    mmState.antiFling = state
    if antiFlingLoop then antiFlingLoop:Disconnect() end
    if state then
        antiFlingLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local linVel = hrp.AssemblyLinearVelocity
                    local angVel = hrp.AssemblyAngularVelocity
                    if linVel.Magnitude > 200 or angVel.Magnitude > 100 then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, linVel.Y, 0)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end)
    end
end

-- GUN FINDER & TP
local function FindGun()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") then
            local name = obj.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then
                if obj.Parent == Workspace or obj.Parent:IsA("Model") then
                    local handle = obj:FindFirstChild("Handle")
                    if handle then
                        return obj, handle
                    end
                end
            end
        end
    end
    return nil, nil
end

local function TpToGunAndPickUp()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local tool, handle = FindGun()
    if tool and handle then
        local originalCFrame = hrp.CFrame
        hrp.CFrame = handle.CFrame * CFrame.new(0, 0, -2)
        task.wait(0.05)
        firetouchinterest(hrp, handle, 0)
        task.wait(0.05)
        firetouchinterest(hrp, handle, 1)
        task.wait(0.05)
        hrp.CFrame = originalCFrame
        Notify("Gun picked up!", Theme.Success)
    else
        Notify("No gun found on the ground", Theme.RedNotif)
    end
end

local autoPickUpConnection
local function ApplyAutoPickUpGun(state)
    mmState.autoPickUpGun = state
    if autoPickUpConnection then autoPickUpConnection:Disconnect() end
    if state then
        autoPickUpConnection = Workspace.DescendantAdded:Connect(function(child)
            if child:IsA("Tool") then
                local name = child.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then
                    task.spawn(function()
                        local handle = child:WaitForChild("Handle", 2)
                        local char = LocalPlayer.Character
                        if handle and char then
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hrp and hum and hum.Health > 0 then
                                task.wait(0.1)
                                if not child.Parent then return end
                                local originalCFrame = hrp.CFrame
                                hrp.CFrame = handle.CFrame
                                firetouchinterest(hrp, handle, 0)
                                task.wait(0.05)
                                firetouchinterest(hrp, handle, 1)
                                task.wait(0.05)
                                hrp.CFrame = originalCFrame
                            end
                        end
                    end)
                end
            end
        end)
    end
end

-- FLING LOGIC
local flingConnection
local function StopFlinging()
    if flingConnection then
        flingConnection:Disconnect()
        flingConnection = nil
    end
    mmState.isFlinging = false
    mmState.flingTarget = nil
end

local function StartFlinging(target)
    StopFlinging()
    mmState.flingTarget = target
    mmState.isFlinging = true
    
    flingConnection = RunService.Heartbeat:Connect(function()
        if mmState.flingTarget and mmState.flingTarget.Character then
            local hrp = mmState.flingTarget.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    if mmState.flingTarget ~= LocalPlayer then
                        hrp:SetNetworkOwner(LocalPlayer)
                    end
                end)
                hrp.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                hrp.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
                hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(9999), math.rad(9999), math.rad(9999))
            else
                StopFlinging()
            end
        else
            StopFlinging()
        end
    end)
end

