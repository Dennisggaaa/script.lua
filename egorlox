local paletteButtons = {}
local chosenPalette = 1

local function ApplyTheme(index)
    chosenPalette = index
    local palette = Palettes[index]
    Theme.Accent = palette[2]
    Theme.Accent2 = palette[3]
    Theme.Watermark = palette[4]

    mainStroke.Color = Theme.Accent
    glowOne.BackgroundColor3 = Theme.Accent
    glowTwo.BackgroundColor3 = Theme.Accent2
    watermarkStroke.Color = Theme.Watermark
    watermarkTime.TextColor3 = Theme.Watermark
    brandGradient.Color = ColorSequence.new(Theme.Accent, Theme.Accent2)

    for _, data in ipairs(accentObjects) do
        if data.object and data.object.Parent then
            data.object[data.property] = Theme.Accent
            local gradient = data.object:FindFirstChildOfClass("UIGradient")
            if gradient then gradient.Color = ColorSequence.new(Theme.Accent, Theme.Accent2) end
        end
    end

    for name, buttonData in pairs(navButtons) do
        local selected = name == activePage
        buttonData.button.BackgroundColor3 = selected and Theme.Accent or Theme.Surface2
        buttonData.icon.TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2
        buttonData.label.TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2
        buttonData.bar.BackgroundColor3 = Theme.Accent2
    end

    for buttonIndex, button in ipairs(paletteButtons) do
        local selected = buttonIndex == index
        Tween(button, {
            BackgroundTransparency = selected and 0 or 0.22,
            Size = selected and UDim2.fromOffset(91, 62) or UDim2.fromOffset(91, 56)
        }, 0.18)
    end
end

