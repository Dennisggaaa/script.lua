-- LOGIC & TABS
local Tabs = {}
local ActiveTab = nil

local function SelectTab(name)
    for _, child in ipairs(PageContainer:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") then child:Destroy() end
    end
    for tabName, tabData in pairs(Tabs) do
        if tabName == name then
            TweenService:Create(tabData.Button, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.4), {TextColor3 = Theme.TextDark}):Play()
        else
            TweenService:Create(tabData.Button, TweenInfo.new(0.4), {BackgroundColor3 = Theme.Element}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.4), {TextColor3 = Theme.Text}):Play()
        end
    end
    PageTitle.Text = name
    ActiveTab = name
    if Tabs[name].Render then Tabs[name].Render() end
end

local function CreateTab(name)
    local Btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.2, AutoButtonColor = false, Text = "", Parent = TabContainer})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Btn})
    local Title = Create("TextLabel", {Name = "Title", Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 15, 0, 0), BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn})
    AddRipple(Btn)
    Tabs[name] = {Button = Btn, Render = nil}
    Btn.MouseButton1Click:Connect(function() SelectTab(name) end)
    return PageContainer
end

