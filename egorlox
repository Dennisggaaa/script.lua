--// Utility
local function Tween(obj, props, dur, easing, dir)
    TweenService:Create(obj, TweenInfo.new(dur or 0.3, easing or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function Corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function Stroke(obj, col, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Theme.Border
    s.Thickness = thick or 1
    s.Transparency = trans or 0
    s.Parent = obj
    return s
end

local function Shadow(obj, depth)
    local sh = Instance.new("ImageLabel")
    sh.Name = "Shadow"
    sh.AnchorPoint = Vector2.new(0.5, 0.5)
    sh.Position = UDim2.new(0.5, 0, 0.5, 0)
    sh.Size = UDim2.new(1, depth or 50, 1, depth or 50)
    sh.BackgroundTransparency = 1
    sh.Image = "rbxassetid://6015897843"
    sh.ImageColor3 = Color3.new(0, 0, 0)
    sh.ImageTransparency = 0.75
    sh.ScaleType = Enum.ScaleType.Slice
    sh.SliceCenter = Rect.new(49, 49, 450, 450)
    sh.ZIndex = obj.ZIndex - 1
    sh.Parent = obj
    return sh
end

