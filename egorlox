    frame.ClipsDescendants = true
    frame.ZIndex = 100
    frame.Parent = NotificationGui
    
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local border = Instance.new("Frame")
    border.Size = UDim2.new(0, 4, 1, 0)
