    local shtl2=Lbl(sh,"Style Settings — Цвет темы",UDim2.new(1,-32,1,0),CFG.TxtPri,Enum.Font.GothamSemibold)
    shtl2.Position=UDim2.new(0,28,0,0); shtl2.TextSize=13; shtl2.ZIndex=25

    -- Описание
    local desc=Instance.new("Frame"); desc.Size=UDim2.new(1,0,0,46)
    desc.BackgroundColor3=CFG.Card; desc.LayoutOrder=1; desc.ZIndex=24; desc.Parent=page
    Corner(desc,10); Stroke(desc,CFG.Sep)
    local dl=Lbl(desc,"Выбери цвет — он применится к ватермарку и рамке меню.",UDim2.new(1,-20,1,0),CFG.TxtSec,Enum.Font.Gotham)
    dl.Position=UDim2.new(0,14,0,0); dl.TextSize=12; dl.TextWrapped=true; dl.ZIndex=25

    -- Палитра цветов
    local colors={
        {name="Indigo",    hex="#5B6EF5"}, {name="Violet",    hex="#9B59B6"},
        {name="Rose",      hex="#FF5F7E"}, {name="Amber",     hex="#FFB347"},
        {name="Emerald",   hex="#4ECCA3"}, {name="Sky",       hex="#38BDF8"},
        {name="Crimson",   hex="#E84545"}, {name="White",     hex="#EAEEFF"},
        {name="Coral",     hex="#FF6B6B"}, {name="Mint",      hex="#3DFFC0"},
        {name="Gold",      hex="#FFD700"}, {name="Cyan",      hex="#00FFFF"},
    }

    -- Сетка цветов
    local grid=Instance.new("Frame"); grid.Size=UDim2.new(1,0,0,0)
    grid.AutomaticSize=Enum.AutomaticSize.Y
    grid.BackgroundColor3=CFG.Card; grid.LayoutOrder=2; grid.ZIndex=24; grid.Parent=page
    Corner(grid,10); Stroke(grid,CFG.Sep); Pad(grid,12,12,12,12)

    local gridLay=Instance.new("UIGridLayout"); gridLay.CellSize=UDim2.new(0,52,0,52)
    gridLay.CellPadding=UDim2.new(0,10,0,10); gridLay.Parent=grid

    local selectedDot=nil   -- текущая выбранная точка

    local function ApplyColor(col)
        CFG.WMColor=col; CFG.Accent=col; CFG.AccentLt=col
        -- Ватермарк
        WMStroke.Color=col
        WMDot.BackgroundColor3=col
        -- Рамка меню
        MFStroke.Color=col
        -- Все зарегистрированные акцент-точки
        for _,dot in ipairs(LIVE.AccentDots) do
            dot.BackgroundColor3=col
        end
    end

    for _, cdata in ipairs(colors) do
        local col=Color3.fromHex(cdata.hex)
        local btn=Instance.new("TextButton"); btn.Size=UDim2.new(0,52,0,52)
        btn.BackgroundColor3=col; btn.Text=""; btn.AutoButtonColor=false
        btn.ZIndex=25; btn.Parent=grid; Corner(btn,14)

        -- Название внутри
        local nl=Instance.new("TextLabel"); nl.Size=UDim2.new(1,0,0,14)
        nl.Position=UDim2.new(0,0,1,-16); nl.BackgroundTransparency=1
        nl.Text=cdata.name; nl.TextColor3=Color3.new(1,1,1); nl.TextSize=9
        nl.Font=Enum.Font.Gotham; nl.TextXAlignment=Enum.TextXAlignment.Center
        nl.ZIndex=26; nl.Parent=btn

        -- Галочка выбора
        local check=Instance.new("Frame"); check.Size=UDim2.new(0,14,0,14)
        check.Position=UDim2.new(1,-16,0,2); check.BackgroundColor3=Color3.new(1,1,1)
        check.BackgroundTransparency=1; check.ZIndex=27; check.Parent=btn; Corner(check,7)
        local checkL=Instance.new("TextLabel"); checkL.Size=UDim2.new(1,0,1,0)
        checkL.BackgroundTransparency=1; checkL.Text="✓"; checkL.TextColor3=Color3.new(0,0,0)
        checkL.TextSize=10; checkL.Font=Enum.Font.GothamBold
        checkL.TextXAlignment=Enum.TextXAlignment.Center; checkL.ZIndex=28; checkL.Parent=check

        btn.MouseEnter:Connect(function()
            Tw(btn,{Size=UDim2.new(0,56,0,56)},0.12):Play()
        end)
        btn.MouseLeave:Connect(function()
            Tw(btn,{Size=UDim2.new(0,52,0,52)},0.12):Play()
        end)
        btn.MouseButton1Click:Connect(function()
            -- снять старую галочку
            if selectedDot then
                Tw(selectedDot,{BackgroundTransparency=1},0.1):Play()
            end
            selectedDot=check
            Tw(check,{BackgroundTransparency=0},0.1):Play()
            ApplyColor(col)
        end)
    end

    -- Hex ввод (информационный)
    local hexCard=Instance.new("Frame"); hexCard.Size=UDim2.new(1,0,0,52)
    hexCard.BackgroundColor3=CFG.Card; hexCard.LayoutOrder=3; hexCard.ZIndex=24; hexCard.Parent=page
    Corner(hexCard,10); Stroke(hexCard,CFG.Sep)
    local hexLbl=Lbl(hexCard,"Текущий акцент:",UDim2.new(0,120,1,0),CFG.TxtSec,Enum.Font.Gotham)
    hexLbl.Position=UDim2.new(0,14,0,0); hexLbl.TextSize=12; hexLbl.ZIndex=25

    local hexBox=Instance.new("TextBox"); hexBox.Size=UDim2.new(0,160,0,30)
    hexBox.Position=UDim2.new(0,140,0.5,-15); hexBox.BackgroundColor3=Color3.fromHex("#0D0F1A")
    hexBox.TextColor3=CFG.AccentLt; hexBox.Text="#5B6EF5"; hexBox.TextSize=13
    hexBox.Font=Enum.Font.GothamSemibold; hexBox.ZIndex=25
    hexBox.ClearTextOnFocus=false; hexBox.Parent=hexCard; Corner(hexBox,8); Stroke(hexBox,CFG.Sep)
    Pad(hexBox,0,0,8,8)

    -- Применить по HEX
    local applyBtn=Instance.new("TextButton"); applyBtn.Size=UDim2.new(0,70,0,30)
    applyBtn.Position=UDim2.new(1,-84,0.5,-15)
    applyBtn.BackgroundColor3=CFG.Accent; applyBtn.Text="Готово"
    applyBtn.TextColor3=Color3.new(1,1,1); applyBtn.TextSize=12; applyBtn.Font=Enum.Font.GothamBold
    applyBtn.AutoButtonColor=false; applyBtn.ZIndex=25; applyBtn.Parent=hexCard; Corner(applyBtn,8)
    applyBtn.MouseButton1Click:Connect(function()
        local ok,col=pcall(function() return Color3.fromHex(hexBox.Text) end)
        if ok then ApplyColor(col) end
    end)

    return page
end

