local function CreateExpandable(page, title, desc, subOptions, isNested, parentUpdate, defaultState, onToggle)
    local Container = Create("Frame", {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.2, BorderSizePixel = 0, Parent = page})
    Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = Container})
