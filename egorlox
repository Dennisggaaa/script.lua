--   СБОРКА ВКЛАДОК
-- ══════════════════════════════════════════════
local TABS={
    {name="AA",       icon="◈", label="AA"},
    {name="SS",       icon="✦", label="SS"},
    {name="Settings", icon="⚙", label="Настройки"},
}

local pages={
    BuildAA(ContentArea),
    BuildSS(ContentArea),
    BuildSettings(ContentArea),
}

local tabBtns={}; local activeTab=nil

local function SwitchTab(idx)
    if activeTab==idx then return end; activeTab=idx
    for _,pg in ipairs(pages) do pg.Visible=false end
    pages[idx].Visible=true
    for i,btn in ipairs(tabBtns) do
        local on=(i==idx)
        Tw(btn,{BackgroundColor3=on and CFG.TabOn or CFG.TabOff, BackgroundTransparency=on and 0 or 1}):Play()
        for _,ch in ipairs(btn:GetChildren()) do
            if ch:IsA("TextLabel") then
                Tw(ch,{TextColor3=on and Color3.new(1,1,1) or CFG.TxtSec}):Play()
            end
        end
    end
end

for i,td in ipairs(TABS) do
    local btn=Instance.new("TextButton"); btn.Size=UDim2.new(0,0,1,-12)
    btn.AutomaticSize=Enum.AutomaticSize.X
    btn.BackgroundColor3=CFG.TabOff; btn.BackgroundTransparency=1
    btn.Text=""; btn.AutoButtonColor=false; btn.LayoutOrder=i; btn.ZIndex=23; btn.Parent=TabBar
    Corner(btn,8)
    local bp=Instance.new("UIPadding"); bp.PaddingLeft=UDim.new(0,14); bp.PaddingRight=UDim.new(0,14); bp.Parent=btn
    local bl=Instance.new("UIListLayout"); bl.FillDirection=Enum.FillDirection.Horizontal
    bl.VerticalAlignment=Enum.VerticalAlignment.Center; bl.Padding=UDim.new(0,6); bl.Parent=btn
    local icoL=Instance.new("TextLabel"); icoL.BackgroundTransparency=1; icoL.Size=UDim2.new(0,14,1,0)
    icoL.Text=td.icon; icoL.TextColor3=CFG.TxtSec; icoL.TextSize=12; icoL.Font=Enum.Font.GothamBold
    icoL.ZIndex=24; icoL.Parent=btn
    local txtL=Instance.new("TextLabel"); txtL.BackgroundTransparency=1; txtL.Size=UDim2.new(0,0,1,0)
    txtL.AutomaticSize=Enum.AutomaticSize.X; txtL.Text=td.label; txtL.TextColor3=CFG.TxtSec
    txtL.TextSize=13; txtL.Font=Enum.Font.GothamSemibold; txtL.ZIndex=24; txtL.Parent=btn
    btn.MouseEnter:Connect(function()
        if activeTab~=i then Tw(btn,{BackgroundColor3=Color3.fromHex("#1F2442"),BackgroundTransparency=0}):Play() end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab~=i then Tw(btn,{BackgroundTransparency=1}):Play() end
    end)
    btn.MouseButton1Click:Connect(function() SwitchTab(i) end)
    tabBtns[i]=btn
end

-- ══════════════════════════════════════════════
--   ДРАГ МЕНЮ (Mouse + Touch для Android)
-- ══════════════════════════════════════════════
local dragging=false; local dStart,dPos

local function IsDragInput(inp)
    return inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch
end
local function IsMoveInput(inp)
    return inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch
end

Header.InputBegan:Connect(function(inp)
    if IsDragInput(inp) then
        dragging=true; dStart=inp.Position; dPos=MF.Position
    end
end)
Header.InputEnded:Connect(function(inp)
    if IsDragInput(inp) then dragging=false end
end)
UserInputService.InputChanged:Connect(function(inp)
    if dragging and IsMoveInput(inp) then
        local d=inp.Position-dStart
        MF.Position=UDim2.new(dPos.X.Scale,dPos.X.Offset+d.X, dPos.Y.Scale,dPos.Y.Offset+d.Y)
    end
end)

