    l.BackgroundTransparency = 1; l.Size = sz or UDim2.new(1, 0, 0, 20)
    l.Text = text or ""; l.TextColor3 = col or CFG.TxtPri
    l.TextSize = size or 14; l.Font = font or Enum.Font.GothamMedium
    l.TextXAlignment = Enum.TextXAlignment.Left; l.RichText = true; l.Parent = parent
