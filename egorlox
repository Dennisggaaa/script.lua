local function CreateExpandable(page, title, desc, subOptions, isNested, parentUpdate, defaultState, onToggle)
    local Container = Create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = page})
    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = Container})
