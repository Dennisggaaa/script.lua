-- ══════════════ MM2 ROLE DETECTION ══════════════
local function getPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    
    local char = player.Character
    
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local toolName = tool.Name:lower()
        if toolName:find("knife") or toolName:find("dagger") or toolName:find("blade") then
            return "Murderer"
        elseif toolName:find("gun") or toolName:find("pistol") or toolName:find("revolver") or toolName:find("revoler") then
            return "Sheriff"
        end
    end
    
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local itemName = item.Name:lower()
                if itemName:find("knife") or itemName:find("dagger") or itemName:find("blade") then
                    return "Murderer"
                elseif itemName:find("gun") or itemName:find("pistol") or itemName:find("revolver") or itemName:find("revoler") then
                    return "Sheriff"
                end
            end
        end
    end
    
    for _, obj in ipairs(player:GetChildren()) do
        if obj:IsA("StringValue") and obj.Name:lower():find("role") then
            local val = obj.Value:lower()
            if val:find("murder") then return "Murderer" end
            if val:find("sheriff") or val:find("sherrif") then return "Sheriff" end
        end
        if obj:IsA("StringValue") and obj.Name:lower():find("team") then
            local val = obj.Value:lower()
            if val:find("murder") then return "Murderer" end
            if val:find("sheriff") or val:find("sherrif") then return "Sheriff" end
        end
    end
    
    if char:FindFirstChild("Knife") or char:FindFirstChild("Dagger") or char:FindFirstChild("Blade") then
        return "Murderer"
    end
    if char:FindFirstChild("Gun") or char:FindFirstChild("Pistol") or char:FindFirstChild("Revolver") then
        return "Sheriff"
    end
    
    return "Innocent"
end

-- ══════════════ CHAMS SYSTEM (MM2) ══════════════
local chamsObjects = {}

local function createChamsForPlayer(player)
    if chamsObjects[player] then return chamsObjects[player] end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "MM2_Chams_" .. player.Name
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(0, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = nil
    
    chamsObjects[player] = {
        highlight = highlight,
        char = nil,
        role = "Innocent",
    }
    
    return chamsObjects[player]
end

local function removeChamsForPlayer(player)
    local data = chamsObjects[player]
    if data then
        if data.highlight then data.highlight:Destroy() end
        chamsObjects[player] = nil
    end
end

local function updateChamsForPlayer(player)
    local data = chamsObjects[player]
    if not data then return end
    
    local char = player.Character
    if not char then
        data.highlight.Enabled = false
        return
    end
    
    local role = getPlayerRole(player)
    data.role = role
    data.char = char
    
    local shouldShow = false
    local color = Color3.new(1, 1, 1)
    
    if espState.chamsMurder and role == "Murderer" then
        shouldShow = true
        color = Color3.fromHex("#FF0000")
    elseif espState.chamsSheriff and role == "Sheriff" then
        shouldShow = true
        color = Color3.fromHex("#0000FF")
    end
    
    if shouldShow then
        if data.highlight.Parent ~= char then
            data.highlight.Parent = char
        end
        data.highlight.Enabled = true
        data.highlight.FillColor = color
        data.highlight.OutlineColor = Color3.new(0, 0, 0)
        data.highlight.FillTransparency = 0.5
        data.highlight.OutlineTransparency = 0
    else
        data.highlight.Enabled = false
    end
end

local chamsLoop
local function StartChamsLoop()
    if chamsLoop then chamsLoop:Disconnect() end
    chamsLoop = RunService.RenderStepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not chamsObjects[player] then
                    createChamsForPlayer(player)
                end
                updateChamsForPlayer(player)
            end
        end
        
        for player, _ in pairs(chamsObjects) do
            if not Players:FindFirstChild(player.Name) then
                removeChamsForPlayer(player)
            end
        end
    end)
end

Players.PlayerRemoving:Connect(function(player)
    removeChamsForPlayer(player)
end)

StartChamsLoop()

-- ══════════════ WALLSHOT SYSTEM ══════════════
local wallShotHooked = false

local function ApplyWallShot(state)
    mmState.wallShot = state
    
    if state and not wallShotHooked then
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        
        setreadonly(mt, false)
        
        local originalNamecall = oldNamecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if mmState.wallShot then
                if method == "Raycast" and self == workspace then
                    local params = args[3]
                    if params and params.FilterDescendantsInstances then
                        local newFilter = {}
                        for _, inst in ipairs(params.FilterDescendantsInstances) do
                            if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
                                table.insert(newFilter, inst)
                            elseif inst == LocalPlayer.Character then
                                table.insert(newFilter, inst)
                            end
                        end
                        params.FilterDescendantsInstances = newFilter
                    end
                elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                    if method == "FindPartOnRayWithIgnoreList" and args[2] then
                        local newFilter = {}
                        for _, inst in ipairs(args[2]) do
                            if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
                                table.insert(newFilter, inst)
                            end
                        end
                        args[2] = newFilter
                    end
                end
            end
            
            return originalNamecall(self, unpack(args))
        end)
        
        setreadonly(mt, true)
        wallShotHooked = true
    end
end

-- ══════════════ ANTI-FLING SYSTEM ══════════════
local antiFlingLoop
local lastGoodPositions = {}

local function ApplyAntiFling(state)
    mmState.antiFling = state
    
    if antiFlingLoop then antiFlingLoop:Disconnect() end
    
    if state then
        antiFlingLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then return end
            
            local rootVel = root.AssemblyLinearVelocity
            local rootAngVel = root.AssemblyAngularVelocity
            
            local linearMag = rootVel.Magnitude
            local angularMag = rootAngVel.Magnitude
            
            if linearMag > 500 or angularMag > 500 then
                if lastGoodPositions[char] then
                    root.CFrame = lastGoodPositions[char]
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part:CanSetNetworkOwnership() then
                            part:SetNetworkOwner(nil)
                        end
                    end
                end
            else
                if linearMag < 100 then
                    lastGoodPositions[char] = root.CFrame
                end
            end
            
            if angularMag > 300 then
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                if lastGoodPositions[char] then
                    root.CFrame = lastGoodPositions[char]
                end
            end
        end)
    end
end

