    local data = espObjects[player]
    if data and data.highlight then data.highlight:Destroy() espObjects[player] = nil end
end

local function updateEspForPlayer(player)
    local data = espObjects[player]
    if not data then return end
    local role = playerRoles[player]
    if role ~= "Murderer" and role ~= "Sheriff" then
        local detectedRole = detectRole(player)
        if detectedRole == "Murderer" or detectedRole == "Sheriff" then playerRoles[player] = detectedRole role = detectedRole else role = "Innocent" end
    end
    local shouldHighlight = false local color = Color3.new(1, 1, 1)
    if role == "Murderer" and espState.chamsMurder then shouldHighlight = true color = Color3.fromRGB(255, 0, 64)
    elseif role == "Sheriff" and espState.chamsSherif then shouldHighlight = true color = Color3.fromRGB(0, 170, 255)
    elseif role == "Innocent" and espState.chamsEnemies then shouldHighlight = true color = Color3.fromRGB(0, 255, 0) end
    if shouldHighlight then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if data.highlight.Parent ~= player.Character then data.highlight.Parent = player.Character end
            data.highlight.Enabled = true data.highlight.FillColor = color
        else data.highlight.Enabled = false end
    else data.highlight.Enabled = false end
end

