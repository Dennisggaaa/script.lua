local function SwitchTab(name)
    for _, p in pairs(Pages) do p.Visible = false end
    Pages[name].Visible = true
    for _, t in ipairs(LIVE.Tabs) do
        t.active = (t.name == name)
        Tw(t.btn, { BackgroundColor3 = t.active and CFG.Accent or CFG.TabOff }, 0.18):Play()
        Tw(t.btn, { TextColor3 = t.active and Color3.new(1,1,1) or CFG.TxtSec }, 0.18):Play()
    end
end

