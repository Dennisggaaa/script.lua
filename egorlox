    -- Заголовок
    local sh=Instance.new("Frame"); sh.Size=UDim2.new(1,0,0,44)
    sh.BackgroundColor3=CFG.Card; sh.LayoutOrder=0; sh.ZIndex=24; sh.Parent=page
    Corner(sh,10); Stroke(sh,CFG.Sep)
    local shdot2=Instance.new("Frame"); shdot2.Size=UDim2.new(0,6,0,6)
