                sound.Parent = Workspace
                sound:Play()
            end
        end)
        SendNotification("💥", "MM2", "Server lag deployed!", 3)
    end)
    
    CreateButton(mm2Content, "Clear All Map Objects", function()
        local count = 0
        for _, obj in pairs(Workspace:GetChildren()) do
            if not obj:IsA("Camera") and obj ~= LocalPlayer.Character and not obj:IsA("Terrain") then
                local players = Players:GetPlayers()
                local isPlayer = false
                for _, p in ipairs(players) do
                    if p.Character == obj then isPlayer = true break end
                end
                if not isPlayer then
                    pcall(function() obj:Destroy() end)
                    count = count + 1
                end
            end
        end
        SendNotification("💥", "MM2", "Destroyed " .. count .. " objects!", 2)
    end)
    
