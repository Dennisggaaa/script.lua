                        local fakeGui = Instance.new("ScreenGui")
                        fakeGui.Name = "FakeTradeGUI"
                        fakeGui.Parent = player.PlayerGui
                        local fakeFrame = Instance.new("Frame")
                        fakeFrame.Size = UDim2.new(0.3, 0, 0.4, 0)
                        fakeFrame.Position = UDim2.new(0.35, 0, 0.3, 0)
                        fakeFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        fakeFrame.BackgroundTransparency = 0.3
                        fakeFrame.BorderSizePixel = 2
                        fakeFrame.BorderColor3 = C.Gold
                        fakeFrame.Parent = fakeGui
                        CreateRoundedCorner(fakeFrame, 10)
                        local fakeText = Instance.new("TextLabel")
                        fakeText.Size = UDim2.new(1, 0, 1, 0)
                        fakeText.BackgroundTransparency = 1
                        fakeText.Text = "TRADE FROZEN\nItems: " .. table.concat(fakeItems, ", ")
                        fakeText.TextColor3 = C.Gold
                        fakeText.TextSize = 14
                        fakeText.Font = Enum.Font.GothamBold
                        fakeText.TextWrapped = true
                        fakeText.Parent = fakeFrame
                        wait(5)
                        fakeGui:Destroy()
                    end
                end
                -- Убираем кнопку после использования
                if confirmBtn then
                    confirmBtn:Destroy()
                    confirmBtn = nil
                end
                scamActive = false
                scamBtn.BackgroundColor3 = C.Success
                scamBtn.Text = "💰 ScamTrade"
            end)
        else
            if confirmBtn then
                confirmBtn:Destroy()
                confirmBtn = nil
            end
        end
    end)

    -- Сохраняем вкладки
    tabContent = {tab1, tab2, tab3, tab4}

    -- ============================================================
    --  ПЕРЕТАСКИВАНИЕ
    -- ============================================================
    local dragging = false
    local dragStart = nil
    local frameStart = nil

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            frameStart = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newX = frameStart.X.Offset + delta.X
            local newY = frameStart.Y.Offset + delta.Y
            newX = Clamp(newX, -frame.AbsoluteSize.X + 100, ScreenGui.AbsoluteSize.X - 100)
            newY = Clamp(newY, 0, ScreenGui.AbsoluteSize.Y - 60)
            frame.Position = UDim2.new(0, newX, 0, newY)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if dragging then
            dragging = false
        end
    end)

    -- Эффекты
    spawn(function()
        while outerGlow and outerGlow.Parent do
            TweenService:Create(outerGlow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.84, Size = UDim2.new(1, 48, 1, 48), Position = UDim2.new(0, -24, 0, -24)
            }):Play()
            TweenService:Create(outerGlow2, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.9, Size = UDim2.new(1, 70, 1, 70), Position = UDim2.new(0, -35, 0, -35)
            }):Play()
            wait(1.8)
            TweenService:Create(outerGlow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.88, Size = UDim2.new(1, 40, 1, 40), Position = UDim2.new(0, -20, 0, -20)
            }):Play()
            TweenService:Create(outerGlow2, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.94, Size = UDim2.new(1, 60, 1, 60), Position = UDim2.new(0, -30, 0, -30)
            }):Play()
            wait(1.8)
        end
    end)

    spawn(function()
        while corners and #corners > 0 and corners[1].Parent do
            for i, corner in ipairs(corners) do
                corner.Rotation = corner.Rotation + 1.5
                TweenService:Create(corner, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    BackgroundTransparency = 0.4 + math.sin(tick() * 2 + i) * 0.2
                }):Play()
            end
            wait(0.03)
        end
    end)

    spawn(function()
        while particlesContainer and particlesContainer.Parent do
            if frame.Visible then
                local x = math.random(0, menuW)
                local y = math.random(0, menuH)
                ParticleSystem:CreateParticle(particlesContainer, x, y, math.random(2, 5), {C.Primary, C.Cyan, C.Purple, C.Gold}[math.random(1, 4)], 20, 4, "circle", true)
            end
            wait(0.08)
        end
    end)

    print("[SeraphiCA] Main menu created successfully with tabs")
    return frame
end

