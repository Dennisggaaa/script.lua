    })
    Create("TextLabel", {
        Size = UDim2.new(1, -80, 0, 14),
        Position = UDim2.new(0, 15, 0, 27),
        BackgroundTransparency = 1,
        Text = "Select a player to fling them around.",
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Theme.Description,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header
    })

    local Switch = Create("TextButton", {
        Size = UDim2.new(0, 34, 0, 16),
        Position = UDim2.new(1, -49, 0.5, -8),
        BackgroundColor3 = Theme.Disabled,
        AutoButtonColor = false,
        Text = "",
        Parent = Header
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Switch})
    local Indicator = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = Switch
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Indicator})

    local SubContainer = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 50),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,
        Parent = Container
    })
    Create("UIListLayout", {Padding = UDim.new(0, 5), Parent = SubContainer})
    Create("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = SubContainer})

    local state = false
    local expanded = false

    local function UpdateSize()
        local baseHeight = 50
        local subHeight = expanded and (SubContainer.UIListLayout.AbsoluteContentSize.Y + 10) or 0
        TweenService:Create(Container, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, baseHeight + subHeight)}):Play()
        TweenService:Create(SubContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, subHeight)}):Play()
    end

    Header.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(Switch, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Theme.TextDark}):Play()
            expanded = true
        else
            TweenService:Create(Switch, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Disabled}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Theme.Text}):Play()
            expanded = false
        end
        UpdateSize()
    end)

    local PlayerList = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 120),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = SubContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = PlayerList})
    Create("UIListLayout", {Padding = UDim.new(0, 3), Parent = PlayerList})
    Create("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = PlayerList})
    PlayerList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        PlayerList.CanvasSize = UDim2.new(0, 0, 0, PlayerList.UIListLayout.AbsoluteContentSize.Y + 6)
    end)

    local ActionBtn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Theme.Disabled,
        AutoButtonColor = false,
        Text = "Fling!",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Theme.Description,
        Active = false,
        Parent = SubContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = ActionBtn})

    local selectedPlayer = nil
    local isFlinging = false

    local function UpdateActionBtn()
        if isFlinging then
            TweenService:Create(ActionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.RedNotif, TextColor3 = Theme.Text}):Play()
            ActionBtn.Text = "Stop!"
            ActionBtn.Active = true
        elseif selectedPlayer then
            TweenService:Create(ActionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextDark}):Play()
            ActionBtn.Text = "Fling!"
            ActionBtn.Active = true
        else
            TweenService:Create(ActionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Disabled, TextColor3 = Theme.Description}):Play()
            ActionBtn.Text = "Fling!"
            ActionBtn.Active = false
        end
    end

    local function PopulatePlayers()
        for _, child in ipairs(PlayerList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local PlrBtn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 25),
                    BackgroundColor3 = Theme.Element,
                    AutoButtonColor = false,
                    Text = "",
                    Parent = PlayerList
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = PlrBtn})
                
                Create("TextLabel", {
                    Size = UDim2.new(1, -10, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = plr.Name,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = PlrBtn
                })
                
                PlrBtn.MouseButton1Click:Connect(function()
                    if isFlinging then return end
                    selectedPlayer = plr
                    
                    for _, btn in ipairs(PlayerList:GetChildren()) do
                        if btn:IsA("TextButton") then
                            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Element}):Play()
                            btn.TextLabel.TextColor3 = Theme.Text
                        end
                    end
                    
                    TweenService:Create(PlrBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Accent}):Play()
                    PlrBtn.TextLabel.TextColor3 = Theme.TextDark
                    UpdateActionBtn()
                end)
            end
        end
    end

    PopulatePlayers()
    Players.PlayerAdded:Connect(PopulatePlayers)
    Players.PlayerRemoving:Connect(PopulatePlayers)

    ActionBtn.MouseButton1Click:Connect(function()
        if not ActionBtn.Active then return end
        
        if isFlinging then
            isFlinging = false
            Notify("Fling stopped", Theme.Success)
        else
            isFlinging = true
            Notify("Flinging " .. (selectedPlayer and selectedPlayer.Name or "player") .. "!", Theme.Accent)
        end
        UpdateActionBtn()
    end)
end

