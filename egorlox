local TabBtns = {}
local TabFrames = {}
local ActiveTab = nil

local function MakeTab(data)
    local btn = Instance.new("TextButton")
    btn.Name = data.Name .. "Tab"
    btn.Size = UDim2.new(1, -24, 0, 52)
    btn.BackgroundColor3 = Theme.Bg
    btn.Text = "  " .. data.Name
    btn.TextColor3 = Theme.TextMuted
    btn.TextSize = 15
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.LayoutOrder = data.Layout
    btn.Parent = Sidebar

    Corner(btn, 12)

    local ind = Instance.new("Frame")
    ind.Name = "Indicator"
    ind.Size = UDim2.new(0, 4, 0, 0)
    ind.Position = UDim2.new(0, 0, 0.5, 0)
    ind.AnchorPoint = Vector2.new(0, 0.5)
    ind.BackgroundColor3 = CFG.Accent
    ind.BorderSizePixel = 0
    ind.Parent = btn

    Corner(ind, 2)

    if data.Locked then
        local lock = Instance.new("TextLabel")
        lock.Size = UDim2.new(0, 40, 1, 0)
        lock.Position = UDim2.new(1, -44, 0, 0)
        lock.BackgroundTransparency = 1
        lock.Text = "[!]"
        lock.TextColor3 = Theme.Red
        lock.TextSize = 14
        lock.Font = Enum.Font.GothamBold
        lock.Parent = btn
    end

    -- Content frame
    local frame = Instance.new("ScrollingFrame")
    frame.Name = data.Name .. "Frame"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.ScrollBarThickness = 4
    frame.ScrollBarImageColor3 = CFG.Accent
    frame.ScrollBarImageTransparency = 0.4
    frame.Visible = false
    frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    frame.Parent = Content

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 14)
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = frame

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 15)
    pad.Parent = frame

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        frame.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20)
    end)

    TabBtns[data.Name] = btn
    TabFrames[data.Name] = frame

    -- Click handler
    btn.MouseButton1Click:Connect(function()
        if data.Locked then
            Notify("not available yet")
            -- Shake animation
            local base = btn.Position
            Tween(btn, {Position = base + UDim2.new(0, 8, 0, 0)}, 0.06)
            task.wait(0.06)
            Tween(btn, {Position = base + UDim2.new(0, -8, 0, 0)}, 0.06)
            task.wait(0.06)
            Tween(btn, {Position = base}, 0.12)
            return
        end

        if ActiveTab == data.Name then return end

        -- Deactivate old
        if ActiveTab then
            local old = TabBtns[ActiveTab]
            Tween(old, {BackgroundColor3 = Theme.Bg, TextColor3 = Theme.TextMuted}, 0.25)
            Tween(old.Indicator, {Size = UDim2.new(0, 4, 0, 0)}, 0.2)
            TabFrames[ActiveTab].Visible = false
        end

        -- Activate new
        ActiveTab = data.Name
        Tween(btn, {BackgroundColor3 = Theme.PanelHover, TextColor3 = Theme.Text}, 0.25)
        Tween(ind, {Size = UDim2.new(0, 4, 0, 30)}, 0.3, Enum.EasingStyle.Back)

        frame.Visible = true

        -- Stagger animation for slots
        for i, child in ipairs(frame:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then
                child.Position = child.Position + UDim2.new(0, 0, 0, 20)
                child.BackgroundTransparency = 0.4
                Tween(child, {
                    Position = child.Position - UDim2.new(0, 0, 0, 20),
                    BackgroundTransparency = 0
                }, 0.35 + (i * 0.03))
            end
        end
    end)

    btn.MouseEnter:Connect(function()
        if ActiveTab ~= data.Name and not data.Locked then
            Tween(btn, {BackgroundColor3 = Theme.Slot}, 0.2)
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= data.Name then
            Tween(btn, {BackgroundColor3 = Theme.Bg}, 0.2)
        end
    end)

    return frame
end

