local antiAimLoop, bhopLoop, autoFarmLoop = nil, nil, nil
local originalTransparencies = {}

local function toggleAntiAim(state)
    huynaState.AntiAim = state
    if antiAimLoop then antiAimLoop:Disconnect() end
    if state then
        antiAimLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart local hum = char.Humanoid
                hum.AutoRotate = false
                local spinAngle = huynaState.AntiAimType == "Jilter" and math.rad((tick() * 180) % 360) or math.rad(math.random(0, 360))
                local yPos = math.sin(tick() * 40) * 2
                local currentVel = hrp.AssemblyLinearVelocity
                hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + yPos, hrp.Position.Z) * CFrame.Angles(0, spinAngle, 0)
                hrp.AssemblyLinearVelocity = currentVel
            end
        end)
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then char.Humanoid.AutoRotate = true end
    end
end

local function toggleBhop(state)
    huynaState.BunnyHop = state
    if bhopLoop then bhopLoop:Disconnect() end
    if state then
        bhopLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                local hum = char.Humanoid local hrp = char.HumanoidRootPart
                local isJumping = UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump
                if isJumping and hum.FloorMaterial ~= Enum.Material.Air then
                    hum.Jump = true
                    local lookVec = Camera.CFrame.LookVector
                    lookVec = Vector3.new(lookVec.X, 0, lookVec.Z).Unit
                    hrp.AssemblyLinearVelocity = Vector3.new(lookVec.X * huynaState.BhopSpeed, 50, lookVec.Z * huynaState.BhopSpeed)
                end
            end
        end)
    end
end

local function toggleAutoFarm(state)
    huynaState.AutoFarm = state
    if autoFarmLoop then autoFarmLoop:Disconnect() end
    if state then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then originalTransparencies[part] = part.Transparency part.Transparency = 1 end
                if part:IsA("Decal") then originalTransparencies[part] = part.Transparency part.Transparency = 1 end
            end
        end
        autoFarmLoop = RunService.Heartbeat:Connect(function()
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChildOfClass("Humanoid") then return end
            local myHrp = myChar.HumanoidRootPart local myHum = myChar.Humanoid
            local myTool = myChar:FindFirstChildOfClass("Tool") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
            if not myTool then return end
            if myTool.Parent == LocalPlayer.Backpack then myHum:EquipTool(myTool) end

            local closest, shortestDist = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                    if dist < shortestDist then shortestDist = dist closest = p end
                end
            end
            if closest then
                local targetHrp = closest.Character.HumanoidRootPart
                myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
                myHrp.CFrame = CFrame.lookAt(myHrp.Position, targetHrp.Position)
                myTool:Activate()
            end
        end)
    else
        local char = LocalPlayer.Character
        if char then
            for part, trans in pairs(originalTransparencies) do
                if part.Parent then part.Transparency = trans end
            end
        end
        originalTransparencies = {}
    end
end

