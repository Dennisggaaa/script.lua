-- Создание бокса для игрока
local function CreateEspBox(player)
    if espBoxes[player] then return end
    
    local container = Instance.new("Frame")
    container.Name = "ESP_" .. player.Name
    container.Size = UDim2.new(0, 100, 0, 150)
    container.Position = UDim2.new(0, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.Visible = false
    container.Parent = GUI
    
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.Size = UDim2.new(1, 0, 1, 0)
    box.Position = UDim2.new(0, 0, 0, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = espState.color
    box.Parent = container
    
    local outline = Instance.new("UIStroke")
    outline.Color = espState.color
    outline.Thickness = 2
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = box
    
    espBoxes[player] = {
        container = container,
        box = box,
        outline = outline
    }
end

-- Обновление позиций боксов
local function UpdateEspBoxes()
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not IsTeammate(player) then
            local char = player.Character
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if rootPart and humanoid and humanoid.Health > 0 then
                -- Получаем размеры персонажа
                local charSize = char:GetExtentsSize()
                local headPos = rootPart.Position + Vector3.new(0, charSize.Y, 0)
                local feetPos = rootPart.Position - Vector3.new(0, charSize.Y * 0.1, 0)
                
                local headScreen, headOnScreen = camera:WorldToScreenPoint(headPos)
                local feetScreen, feetOnScreen = camera:WorldToScreenPoint(feetPos)
                
                if headOnScreen and feetOnScreen then
                    local boxHeight = math.abs(feetScreen.Y - headScreen.Y)
                    
                    if boxHeight < 10 then
                        if espBoxes[player] then
                            espBoxes[player].container.Visible = false
                        end
                        continue
                    end
                    
                    local boxWidth = boxHeight * 0.45
                    local centerX = (headScreen.X + feetScreen.X) / 2
                    local topY = math.min(headScreen.Y, feetScreen.Y)
                    
                    if not espBoxes[player] then
                        CreateEspBox(player)
                    end
                    
                    local espData = espBoxes[player]
                    espData.container.Position = UDim2.new(0, centerX - boxWidth/2, 0, topY)
                    espData.container.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                    espData.container.Visible = espState.on and espState.box
                    espData.box.BorderColor3 = espState.color
                    espData.outline.Color = espState.color
                else
                    if espBoxes[player] then
                        espBoxes[player].container.Visible = false
                    end
                end
            else
                if espBoxes[player] then
                    espBoxes[player].container.Visible = false
                end
            end
        else
            if espBoxes[player] then
                espBoxes[player].container.Visible = false
            end
        end
    end
    
    -- Удаляем старые боксы
    for player, _ in pairs(espBoxes) do
        if not Players:FindFirstChild(player.Name) then
            espBoxes[player].container:Destroy()
            espBoxes[player] = nil
        end
    end
end

-- Chams (подсветка через стены)
local function ApplyChams(player)
    if not player.Character or IsTeammate(player) then return end
    
    -- Удаляем старые чамсы
    if chamsObjects[player] then
        for _, obj in ipairs(chamsObjects[player]) do
            if obj and obj.Parent then
                obj:Destroy()
            end
        end
        chamsObjects[player] = nil
    end
    
    if not espState.chams or not espState.on then return end
    
    local char = player.Character
    local chamsList = {}
    
    -- Обрабатываем только основные части тела
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.Name:find("Chams_") then
            local highlight = Instance.new("Highlight")
            highlight.Parent = part
            highlight.FillColor = espState.color
            highlight.FillTransparency = 0.7
            highlight.OutlineColor = espState.color
            highlight.OutlineTransparency = 0
            highlight.Adornee = part
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            
            table.insert(chamsList, highlight)
        end
    end
    
    chamsObjects[player] = chamsList
end

-- Удаление чамсов
local function RemoveChams(player)
    if chamsObjects[player] then
        for _, obj in ipairs(chamsObjects[player]) do
            if obj and obj.Parent then
                obj:Destroy()
            end
        end
        chamsObjects[player] = nil
    end
end

-- Обновление чамсов (применяется один раз)
local chamsApplied = {}
local function UpdateChams()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if espState.on and espState.chams and player.Character and not IsTeammate(player) then
                if not chamsApplied[player] then
                    ApplyChams(player)
                    chamsApplied[player] = true
                end
            else
                if chamsApplied[player] then
                    RemoveChams(player)
                    chamsApplied[player] = nil
                end
            end
        end
    end
end

-- Запуск ESP
local espConnection
local function StartEspLoop()
    if espConnection then espConnection:Disconnect() end
    espConnection = RunService.RenderStepped:Connect(function()
        if espState.on then
            if espState.box then
                UpdateEspBoxes()
            else
                for _, data in pairs(espBoxes) do
                    data.container.Visible = false
                end
            end
            
            if espState.chams then
                UpdateChams()
            end
        else
            for _, data in pairs(espBoxes) do
                data.container.Visible = false
            end
            for player, _ in pairs(chamsApplied) do
                RemoveChams(player)
                chamsApplied[player] = nil
            end
        end
    end)
end
StartEspLoop()

-- ══════════════ MM ФУНКЦИИ ══════════════
-- WallShot - стрельба через стены
local wallShotApplied = false
local function ApplyWallShot()
    if not mmState.wallShot then
        wallShotApplied = false
        return
    end
    
    if wallShotApplied then return end
    wallShotApplied = true
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Ищем оружие и модифицируем его
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            -- Модифицируем скрипты оружия
            for _, script in ipairs(tool:GetDescendants()) do
                if script:IsA("LocalScript") or script:IsA("Script") then
                    pcall(function()
                        -- Ищем функции связанные с raycast
                        local source = script.Source
                        if source:find("RaycastParams") or source:find("raycast") or source:find("Raycast") then
                            -- Добавляем модификацию для игнорирования стен
                            local newSource = source:gsub("RaycastParams%.new%(%)", "RaycastParams.new(); params.FilterDescendantsInstances = {workspace.Terrain}; params.FilterType = Enum.RaycastFilterType.Exclude")
                            script.Source = newSource
                        end
                    end)
                end
            end
        end
    end
end

-- Infinity Ammo
local infAmmoConnection
local function ApplyInfAmmo()
    if not mmState.infAmmo then
        if infAmmoConnection then
            infAmmoConnection:Disconnect()
            infAmmoConnection = nil
        end
        return
    end
    
    if infAmmoConnection then return end
    
    infAmmoConnection = RunService.Heartbeat:Connect(function()
        if not mmState.infAmmo then
            if infAmmoConnection then
                infAmmoConnection:Disconnect()
                infAmmoConnection = nil
            end
            return
        end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Ищем значения патронов в инструментах
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                -- Ищем IntValue/NumberValue с ammo/bullet
                for _, obj in ipairs(tool:GetDescendants()) do
                    if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                        local name = obj.Name:lower()
                        if name:find("ammo") or name:find("bullet") or name:find("clip") or name:find("magazine") then
                            if obj.Value < 999 then
                                obj.Value = 999
                            end
                        end
                    end
                end
                
                -- Ищем атрибуты
                local ammo = tool:GetAttribute("Ammo") or tool:GetAttribute("ammo")
                if ammo and ammo < 999 then
                    tool:SetAttribute("Ammo", 999)
                end
            end
        end
    end)
end

-- RapidFire
local rapidFireConnection
local function ApplyRapidFire()
    if not mmState.rapidFire then
        if rapidFireConnection then
            rapidFireConnection:Disconnect()
            rapidFireConnection = nil
        end
        return
    end
    
    if rapidFireConnection then return end
    
    rapidFireConnection = RunService.Heartbeat:Connect(function()
        if not mmState.rapidFire then
            if rapidFireConnection then
                rapidFireConnection:Disconnect()
                rapidFireConnection = nil
            end
            return
        end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Ищем оружие
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        
        -- Модифицируем fire rate через атрибуты
        local fireRate = tool:GetAttribute("FireRate") or tool:GetAttribute("firerate")
        if fireRate and fireRate > 0.1 then
            tool:SetAttribute("FireRate", 0.05)
        end
        
        local cooldown = tool:GetAttribute("Cooldown") or tool:GetAttribute("cooldown")
        if cooldown and cooldown > 0.1 then
            tool:SetAttribute("Cooldown", 0.05)
        end
        
        -- Модифицируем значения в скриптах
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                local name = obj.Name:lower()
                if name:find("cooldown") or name:find("delay") or name:find("firerate") then
                    if obj.Value > 0.1 then
                        obj.Value = 0.05
                    end
                end
            end
        end
    end)
end

