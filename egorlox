local function Create(className, props, children)
    local obj = Instance.new(className)
    for prop, val in pairs(props) do
        obj[prop] = val
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = obj
        end
    end
    return obj
end

local function AddRipple(btn)
    btn.ClipsDescendants = true
    btn.MouseButton1Down:Connect(function(x, y)
        local ripple = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.8,
            BorderSizePixel = 0,
            Parent = btn
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ripple})
        
        local btnPos = btn.AbsolutePosition
        local btnSize = btn.AbsoluteSize
        local maxSize = math.max(btnSize.X, btnSize.Y) * 2
        
        ripple.Position = UDim2.new(0, (x - btnPos.X) - maxSize/2, 0, (y - btnPos.Y) - maxSize/2)
        ripple.Size = UDim2.new(0, 0, 0, 0)
        
        TweenService:Create(ripple, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, maxSize, 0, maxSize),
            BackgroundTransparency = 1
        }):Play()
        
        task.delay(0.6, function() ripple:Destroy() end)
    end)
end

