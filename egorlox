local function switchPage(name)
    currentPage = name
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end
    for tabName, objects in pairs(tabButtons) do
        local active = tabName == name
        TweenService:Create(objects.Button, TweenInfo.new(0.18), {
            BackgroundTransparency = active and 0 or 1,
            TextColor3 = active and COLORS.Text or COLORS.Muted,
        }):Play()
        TweenService:Create(objects.Marker, TweenInfo.new(0.18), {
            BackgroundTransparency = active and 0 or 1,
        }):Play()
    end
end

for name, objects in pairs(tabButtons) do
    objects.Button.MouseButton1Click:Connect(function()
        switchPage(name)
    end)
    objects.Button.MouseEnter:Connect(function()
        if currentPage ~= name then
            TweenService:Create(objects.Button, TweenInfo.new(0.12), {
                BackgroundTransparency = 0.55,
            }):Play()
        end
    end)
    objects.Button.MouseLeave:Connect(function()
        if currentPage ~= name then
            TweenService:Create(objects.Button, TweenInfo.new(0.12), {
                BackgroundTransparency = 1,
            }):Play()
        end
    end)
end

