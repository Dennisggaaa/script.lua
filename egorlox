-- ══════════════ ОСНОВНАЯ ЛОГИКА AIM-BOT ══════════════
local function GetClosestPlayer()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    
    local maxDistance = aimState.fov
    local bestTarget = nil
    local bestScore = math.huge
    
    local myPos = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
    if not myPos then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character.PrimaryPart then
            local targetPart = player.Character.PrimaryPart
            local targetPos = targetPart.Position
            
            -- Проверка видимости
            if aimState.visCheck then
                local ray = Ray.new(myPos.Position, (targetPos - myPos.Position).Unit * 1000)
                local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
                if hit and not hit:IsDescendantOf(player.Character) then
                    -- Скрыт за стеной
                    continue
                end
            end
            
            -- Конвертация в экранные координаты
            local screenPos, onScreen = camera:WorldToScreenPoint(targetPos)
            if not onScreen then continue end
            
            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            
            if distance <= maxDistance and distance < bestScore then
                bestScore = distance
                bestTarget = player
            end
        end
    end
    
    return bestTarget
end

local function AimAtTarget()
    if not aimState.on then return end
    
    local target = GetClosestPlayer()
    if not target then return end
    
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local targetPart = target.Character and target.Character.PrimaryPart
    if not targetPart then return end
    
    -- Наводим камеру на цель (в голову)
    local targetPos = targetPart.Position + Vector3.new(0, 1.5, 0)
    local direction = (targetPos - camera.CFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
    
    -- Плавность наведения
    local smoothFactor = math.min(aimState.smoothness / 100, 0.95)
    local currentCFrame = camera.CFrame
    local lerpCFrame = currentCFrame:Lerp(targetCFrame, smoothFactor)
    
    camera.CFrame = lerpCFrame
end

-- Запускаем цикл наведения
local aimConnection
local function StartAimLoop()
    if aimConnection then aimConnection:Disconnect() end
    aimConnection = RunService.RenderStepped:Connect(function()
        if aimState.on then
            AimAtTarget()
        end
    end)
end
StartAimLoop()

