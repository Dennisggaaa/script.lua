                AddRipple(PlrBtn)
                PlrBtn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    PopulatePlayers()
                    UpdateActionBtn()
                end)
            end
        end
    end
    PopulatePlayers()
    Players.PlayerAdded:Connect(PopulatePlayers)
    Players.PlayerRemoving:Connect(function(p)
        if selectedPlayer == p then selectedPlayer = nil UpdateActionBtn() end
        PopulatePlayers()
    end)
    ActionBtn.MouseButton1Click:Connect(function()
        if ActionBtn.Active and selectedPlayer then onAction(selectedPlayer) end
    end)
    UpdateActionBtn()
    if state then task.spawn(function() task.wait(0.1) UpdateSize() end) end
end

