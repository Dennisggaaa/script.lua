-- WallShot: модификация RaycastParams
local originalRaycast = workspace.Raycast
local function hookedRaycast(origin, direction, params)
    if mmState.wallShot and params then
        -- Убираем стены из фильтра
        local newFilter = {}
        if params.FilterDescendantsInstances then
            for _, inst in ipairs(params.FilterDescendantsInstances) do
                if inst:IsA("Model") and inst:FindFirstChild("Humanoid") then
                    table.insert(newFilter, inst)
                end
            end
        end
        params.FilterDescendantsInstances = newFilter
    end
    return originalRaycast(workspace, origin, direction, params)
end

local function ApplyWallShot(state)
    mmState.wallShot = state
    if state then
        -- Hook Raycast через metatable
        local mt = getrawmetatable(game)
        if not mmHooks.raycast then
            local oldIndex = mt.__index
            setreadonly(mt, false)
            mmHooks.raycast = oldIndex
            setreadonly(mt, true)
        end
    end
end

-- InfAmmo: мониторинг патронов
local infAmmoLoop
local function ApplyInfAmmo(state)
    mmState.infAmmo = state
    if infAmmoLoop then infAmmoLoop:Disconnect() end
    if state then
        infAmmoLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end

            for _, obj in ipairs(tool:GetDescendants()) do
                if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                    local name = obj.Name:lower()
                    if name:find("ammo") or name:find("bullet") or name:find("mag") or name:find("clip") or name:find("round") then
                        if obj.Value < 30 then
                            obj.Value = 999
                        end
                    end
                end
                if obj:IsA("Configuration") then
                    for _, sub in ipairs(obj:GetDescendants()) do
                        if sub:IsA("IntValue") or sub:IsA("NumberValue") then
                            local name = sub.Name:lower()
                            if name:find("ammo") or name:find("bullet") or name:find("mag") then
                                sub.Value = 999
                            end
                        end
                    end
                end
            end

            -- Backpack tools
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        for _, obj in ipairs(tool:GetDescendants()) do
                            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                                local name = obj.Name:lower()
                                if name:find("ammo") or name:find("bullet") or name:find("mag") then
                                    obj.Value = 999
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end

-- RapidFire: уменьшение задержки выстрела
local rapidFireLoop
local lastFireTime = 0
local function ApplyRapidFire(state)
    mmState.rapidFire = state
    if rapidFireLoop then rapidFireLoop:Disconnect() end
    if state then
        rapidFireLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end

            -- Ищем конфиг оружия
            for _, obj in ipairs(tool:GetDescendants()) do
                if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                    local name = obj.Name:lower()
                    if name:find("fire") and name:find("rate") or name:find("delay") or name:find("cooldown") then
                        obj.Value = 0.01
                    end
                end
                if obj:IsA("Configuration") then
                    for _, sub in ipairs(obj:GetDescendants()) do
                        if sub:IsA("NumberValue") or sub:IsA("IntValue") then
                            local name = sub.Name:lower()
                            if name:find("fire") and name:find("rate") or name:find("delay") or name:find("cooldown") then
                                sub.Value = 0.01
                            end
                        end
                    end
                end
            end

            -- Авто-выстрел при зажатии
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                local now = tick()
                if now - lastFireTime > 0.05 then
                    lastFireTime = now
                    -- Пытаемся активировать инструмент
                    pcall(function()
                        tool:Activate()
                    end)
                end
            end
        end)
    end
end

-- NoRecoil: компенсация отдачи камеры
local noRecoilLoop
local function ApplyNoRecoil(state)
    mmState.noRecoil = state
    if noRecoilLoop then noRecoilLoop:Disconnect() end
    if state then
        local savedCFrame = nil
        noRecoilLoop = RunService.RenderStepped:Connect(function()
            local camera = workspace.CurrentCamera
            if not camera then return end
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")

            if tool then
                -- Сохраняем CFrame когда нет выстрела
                if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    savedCFrame = camera.CFrame
                else
                    -- При выстреле восстанавливаем сохранённый CFrame
                    if savedCFrame then
                        local current = camera.CFrame
                        -- Компенсируем только небольшое смещение (отдача)
                        local diff = (current.Position - savedCFrame.Position).Magnitude
                        local angleDiff = math.acos(math.clamp(current.LookVector:Dot(savedCFrame.LookVector), -1, 1))

                        if diff < 5 and angleDiff < 0.1 then
                            -- Плавная компенсация
                            camera.CFrame = camera.CFrame:Lerp(savedCFrame, 0.8)
                        else
                            -- Большое смещение = движение мыши, обновляем
                            savedCFrame = camera.CFrame
                        end
                    end
                end
            else
                savedCFrame = camera.CFrame
            end
        end)
    end
end

