--// Главный игровой цикл
function StartMainLoop()
    local rainbowAngle = 0
    local lastRoleCheck = 0
    local lastESPUpdate = 0
    local lastFlingTick = 0
    local lastMM2Check = 0
    
    spawn(function()
        while true do
            local dt = RunService.RenderStepped:Wait()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            -- ============ БАЗОВЫЕ ФУНКЦИИ ============
            if ToggleStates.GodMode and hum then
                hum.Health = hum.MaxHealth
            end
            
            if ToggleStates.Fly and hrp and hum then
                local flySpeed = SliderValues.FlySpeed or 100
                local moveDir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then hrp.Velocity = moveDir.Unit * flySpeed else hrp.Velocity = Vector3.new(0, 0, 0) end
                hum.PlatformStand = true
            elseif not ToggleStates.Fly and hum then
                hum.PlatformStand = false
            end
            
            if ToggleStates.NoClip and char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
            
            if ToggleStates.SpinBot and hrp then
                local speed = SliderValues.SpinSpeed or 200
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(speed * dt), 0)
            end
            
            if ToggleStates.Fullbright then
                Lighting.Brightness = 5
                Lighting.ClockTime = 12
            end
            
            if ToggleStates.AlwaysDay then
                Lighting.ClockTime = 12
            end
            
            -- ============ MM2 ФУНКЦИИ ============
            
            -- Автоопределение ролей
            if ToggleStates.MM2AutoDetect and tick() - lastRoleCheck > 2 then
                lastRoleCheck = tick()
                MM2_DetectRoles()
            end
            
            -- MM2 ESP обновление
            if ToggleStates.MM2ESPMaster and tick() - lastESPUpdate > 0.3 then
                lastESPUpdate = tick()
                local roles = MM2.PlayerRoles
                
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local role = MM2_GetPlayerRole(player)
                        local shouldShow = false
                        local color = nil
                        
                        if role == "Sheriff" and ToggleStates.MM2SheriffESP then
                            shouldShow = true
                            color = MM2.SheriffColor
                        elseif role == "Murderer" and ToggleStates.MM2MurdererESP then
                            shouldShow = true
                            color = MM2.MurdererColor
                        elseif role == "Innocent" and ToggleStates.MM2InnocentESP then
                            shouldShow = true
                            color = MM2.InnocentColor
                        elseif role == "Hero" and ToggleStates.MM2HeroESP then
                            shouldShow = true
                            color = MM2.HeroColor
                        end
                        
                        if shouldShow and player.Character then
                            MM2_CreatePlayerESP(player, role, color)
                        else
                            MM2_ClearESP(player.UserId)
                        end
                    end
                end
            elseif not ToggleStates.MM2ESPMaster then
                MM2_ClearAllESP()
            end
            
            -- MM2 God Mode
            if ToggleStates.MM2GodMode and hum then
                hum.Health = hum.MaxHealth
            end
            
            -- MM2 Fly
            if ToggleStates.MM2Fly and hrp and hum then
                local flySpeed = SliderValues.MM2FlySpeed or 80
                local moveDir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then hrp.Velocity = moveDir.Unit * flySpeed else hrp.Velocity = Vector3.new(0, 0, 0) end
                hum.PlatformStand = true
            elseif not ToggleStates.MM2Fly and hum and not ToggleStates.Fly then
                hum.PlatformStand = false
            end
            
            -- MM2 No Clip
            if ToggleStates.MM2NoClip and char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
            
            -- MM2 Fling All (постоянный)
            if ToggleStates.MM2FlingAll and tick() - lastFlingTick > 0.5 then
                lastFlingTick = tick()
                local power = SliderValues.MM2FlingPower or 2000
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        MM2_FlingPlayer(player, power)
                    end
                end
            end
            
            -- MM2 Auto Kill Murderer
            if ToggleStates.MM2AutoKillMurderer and tick() - lastMM2Check > 1 then
                lastMM2Check = tick()
                local murderer = MM2_GetMurderer()
                if murderer and murderer.Character and murderer.Character:FindFirstChild("Humanoid") and murderer.Character.Humanoid.Health > 0 then
                    MM2_KillPlayer(murderer)
                end
            end
            
            -- MM2 Anti Murderer (держит на расстоянии)
            if ToggleStates.MM2AntiMurderer and hrp then
                local murderer = MM2_GetMurderer()
                if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (hrp.Position - murderer.Character.HumanoidRootPart.Position).Magnitude
                    if dist < 15 then
                        MM2_FlingPlayer(murderer, 500)
                    end
                end
            end
            
            -- MM2 Slow Aura
            if ToggleStates.MM2SlowAura and hrp then
                local auraRange = SliderValues.MM2SlowAuraRange or 15
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude
                        if dist < auraRange and player.Character:FindFirstChild("Humanoid") then
                            player.Character.Humanoid.WalkSpeed = 8
                        end
                    end
                end
            end
            
            -- MM2 Murderer Warning (звуковое оповещение)
            if ToggleStates.MM2MurdererWarning and hrp then
                local murderer = MM2_GetMurderer()
                local alertDist = SliderValues.MM2MurdererAlertDist or 20
                if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (hrp.Position - murderer.Character.HumanoidRootPart.Position).Magnitude
                    if dist < alertDist then
                        -- Визуальное предупреждение (можно добавить звук)
                        if not MM2._lastAlert or tick() - MM2._lastAlert > 3 then
                            MM2._lastAlert = tick()
                            SendNotification("⚠️", "MM2 ALERT", "MURDERER NEARBY! Distance: " .. math.floor(dist), 2)
                        end
                    end
                end
            end
            
            -- MM2 Anti Death
            if ToggleStates.MM2AntiDeath and hum and hum.Health <= 10 then
                hum.Health = hum.MaxHealth
            end
            
            wait()
        end
    end)
end

--// Инициализация
function Init()
    if CoreGui:FindFirstChild("SeraphicaHub") then
        CoreGui.SeraphicaHub:Destroy()
    end
    
    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SeraphicaHub"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = CoreGui
    
    NotificationGui = Instance.new("ScreenGui")
    NotificationGui.Name = "SeraphicaNotifications"
    NotificationGui.ResetOnSpawn = false
    NotificationGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    NotificationGui.ZIndex = 100
    NotificationGui.Parent = CoreGui
    
    CreateLoadingScreen()
    
    wait(2.5)
    
    CreateWatermark()
    CreateMainMenu()
    StartMainLoop()
    
    -- Anti-detection
    local mt = getrawmetatable(game)
    if mt then
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = function(self, ...)
            local method = getnamecallmethod()
            if ToggleStates.AntiKick and (method == "Kick" or method == "kick") then
                return nil
            end
            return oldNamecall(self, ...)
        end
        setreadonly(mt, true)
    end
    
    if syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        syn.protect_gui(NotificationGui)
    end
    
    SendNotification("✅", "SERAPHICA", "v2.1 + MM2 Pack loaded!", 6)
    SendNotification("🔪", "MM2", "Open MM2 tab for exclusive features!", 5)
    SendNotification("⬡", "CREDITS", "Made by @Mpmtww | t.me/Mpmtww", 5)
end

--// Запуск
pcall(function()
    Init()
end)
