--// НАВИГАЦИОННЫЕ КНОПКИ
local function switchPage(name)
    if activePage == name then return end
    activePage = name

    pageTitle.Text = name
    pageSubtitle.Text = navInfo[name].description

    for pageName, page in pairs(pageFrames) do
        page.Visible = pageName == name
    end

    for buttonName, data in pairs(navButtons) do
        local selected = buttonName == name
        Tween(data.button, {
            BackgroundColor3 = selected and Theme.Accent or Theme.Surface2,
            BackgroundTransparency = selected and 0.06 or 0.56
        }, 0.18)
        Tween(data.bar, {BackgroundTransparency = selected and 0 or 1}, 0.18)
        data.icon.TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2
        data.label.TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2
    end
end

for index, name in ipairs(pageOrder) do
    local info = navInfo[name]
    local selected = name == activePage

    local button = New("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 51),
        BackgroundColor3 = selected and Theme.Accent or Theme.Surface2,
        BackgroundTransparency = selected and 0.06 or 0.56,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = index,
        ZIndex = 8
    }, navHolder)
    Round(button, 12)

    local bar = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 25),
        BackgroundColor3 = Theme.Accent2,
        BackgroundTransparency = selected and 0 or 1,
        BorderSizePixel = 0,
        ZIndex = 9
    }, button)
    Round(bar, 5)

    local icon = New("TextLabel", {
        Position = UDim2.fromOffset(17, 0),
        Size = UDim2.fromOffset(25, 51),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = info.icon,
        TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2,
        TextSize = 17,
        ZIndex = 9
    }, button)

    local label = New("TextLabel", {
        Position = UDim2.fromOffset(53, 0),
        Size = UDim2.new(1, -60, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamSemibold,
        Text = name,
        TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text2,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 9
    }, button)

    navButtons[name] = {button = button, bar = bar, icon = icon, label = label}

    button.MouseEnter:Connect(function()
        if activePage ~= name then
            Tween(button, {BackgroundTransparency = 0.34}, 0.14)
        end
    end)
    button.MouseLeave:Connect(function()
        if activePage ~= name then
            Tween(button, {BackgroundTransparency = 0.56}, 0.14)
        end
    end)
    button.MouseButton1Click:Connect(function()
        switchPage(name)
    end)
end

--// ОТКРЫТИЕ / ЗАКРЫТИЕ ЧЕРЕЗ ВАТЕРМАРК
local menuOpen = true
local menuBusy = false

local function setMenu(open)
    if menuBusy or menuOpen == open then return end
    menuBusy = true
    menuOpen = open

    if open then
        main.Visible = true
        mainShadow.Visible = true
        main.Position = UDim2.new(0.5, 0, 0, 43)
        main.BackgroundTransparency = 1
        mainShadow.BackgroundTransparency = 1
        watermarkHint.Text = "−"

        Tween(main, {
            Position = UDim2.new(0.5, 0, 0, 53),
            BackgroundTransparency = 0
        }, 0.28, Enum.EasingStyle.Quint)
        Tween(mainShadow, {BackgroundTransparency = 0.55}, 0.28)

        task.delay(0.29, function()
            menuBusy = false
        end)
    else
        watermarkHint.Text = "+"
        Tween(main, {
            Position = UDim2.new(0.5, 0, 0, 43),
            BackgroundTransparency = 1
        }, 0.22, Enum.EasingStyle.Quint)
        Tween(mainShadow, {BackgroundTransparency = 1}, 0.2)

        task.delay(0.23, function()
            main.Visible = false
            mainShadow.Visible = false
            menuBusy = false
        end)
    end
end

watermark.MouseButton1Click:Connect(function()
    setMenu(not menuOpen)
end)

watermark.MouseEnter:Connect(function()
    Tween(watermark, {Size = UDim2.fromOffset(288, 42)}, 0.15)
    Tween(watermarkStroke, {Transparency = 0}, 0.15)
end)

watermark.MouseLeave:Connect(function()
    Tween(watermark, {Size = UDim2.fromOffset(282, 40)}, 0.15)
    Tween(watermarkStroke, {Transparency = 0.18}, 0.15)
end)

--// ПЕРЕТАСКИВАНИЕ ОКНА ЗА ПУСТУЮ ОБЛАСТЬ ЗАГОЛОВКА
local dragging = false
local dragStart
local startPosition
local dragInput

contentHeader.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
        dragInput = input
    end
end)

contentHeader.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput and main.Visible then
        local delta = input.Position - dragStart
        local newPosition = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
        main.Position = newPosition
        mainShadow.Position = UDim2.new(
            newPosition.X.Scale,
            newPosition.X.Offset,
            newPosition.Y.Scale,
            newPosition.Y.Offset + 4
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

