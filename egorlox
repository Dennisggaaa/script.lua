local function CreateTab(name, icon)
    local tab = Instance.new("ImageButton")
    tab.Size = UDim2.new(1, -12, 0, 42)
    tab.Position = UDim2.new(0, 6, 0, 5)
    tab.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tab.BackgroundTransparency = 0.9
    tab.AutoButtonColor = false
    tab.Parent = TabContainer

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 10)
    tabCorner.Parent = tab

    local tabLabel = Instance.new("TextLabel")
    tabLabel.Size = UDim2.new(1, -12, 1, 0)
    tabLabel.Position = UDim2.new(0, 12, 0, 0)
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text = icon .. "  " .. name
    tabLabel.Font = HANDWRITING_FONT
    tabLabel.TextSize = 14
    tabLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabLabel.Parent = tab

    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = ContentFrame

    return {
        Button = tab,
        Label = tabLabel,
        Page = page
    }
end

local SettingsTab = CreateTab("Settings", "⚙")
local DevTab = CreateTab("Dev", "💻")

local SelectedTab = SettingsTab
local function SwitchTab(tab)
    if SelectedTab then
        local oldTween = TweenService:Create(SelectedTab.Button, TweenInfo.new(0.2), {
            BackgroundTransparency = 0.9
        })
        oldTween:Play()
        SelectedTab.Label.TextColor3 = Color3.fromRGB(200, 200, 200)
        SelectedTab.Page.Visible = false
    end

    SelectedTab = tab

    local newTween = TweenService:Create(tab.Button, TweenInfo.new(0.2), {
        BackgroundTransparency = 0.7
    })
    newTween:Play()
    tab.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    tab.Page.Visible = true
end

SettingsTab.Button.MouseButton1Click:Connect(function() SwitchTab(SettingsTab) end)
DevTab.Button.MouseButton1Click:Connect(function() SwitchTab(DevTab) end)

