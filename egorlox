    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.Font = FONT
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = container

    -- HSV холст
    local canvas = Instance.new("ImageButton")
    canvas.Size = UDim2.new(1, 0, 0, 110)
    canvas.Position = UDim2.new(0, 0, 0, 24)
    canvas.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    canvas.Image = "rbxassetid://4155801252"
    canvas.AutoButtonColor = false
    canvas.Active = true
    canvas.Parent = container

    local canvasCorner = Instance.new("UICorner")
    canvasCorner.CornerRadius = UDim.new(0, 6)
    canvasCorner.Parent = canvas

    -- Hue слайдер
    local hueFrame = Instance.new("Frame")
    hueFrame.Size = UDim2.new(1, 0, 0, 16)
    hueFrame.Position = UDim2.new(0, 0, 0, 138)
    hueFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hueFrame.Active = true
    hueFrame.Parent = container

    local hueCorner = Instance.new("UICorner")
    hueCorner.CornerRadius = UDim.new(0, 6)
    hueCorner.Parent = hueFrame

    local hueGradient = Instance.new("UIGradient")
    hueGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
    })
    hueGradient.Parent = hueFrame

    local hueKnob = Instance.new("Frame")
    hueKnob.Size = UDim2.new(0, 8, 0, 20)
    hueKnob.AnchorPoint = Vector2.new(0.5, 0.5)
    hueKnob.Position = UDim2.new(0, 0, 0.5, 0)
    hueKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hueKnob.BorderSizePixel = 0
    hueKnob.Parent = hueFrame

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(0, 4)
    knobCorner.Parent = hueKnob

    -- Быстрые цвета
    local presetColors = {
        Color3.fromRGB(12, 12, 12),
        Color3.fromRGB(25, 25, 35),
        Color3.fromRGB(35, 15, 25),
        Color3.fromRGB(15, 25, 15),
        Color3.fromRGB(25, 15, 15),
        Color3.fromRGB(15, 15, 25),
        Color3.fromRGB(30, 10, 30),
        Color3.fromRGB(10, 30, 30)
    }

    local presetFrame = Instance.new("Frame")
    presetFrame.Size = UDim2.new(1, 0, 0, 22)
    presetFrame.Position = UDim2.new(0, 0, 0, 160)
    presetFrame.BackgroundTransparency = 1
    presetFrame.Parent = container

    local presetLayout = Instance.new("UIListLayout")
    presetLayout.FillDirection = Enum.FillDirection.Horizontal
    presetLayout.Padding = UDim.new(0, 5)
    presetLayout.Parent = presetFrame

    for _, color in ipairs(presetColors) do
        local preset = Instance.new("ImageButton")
        preset.Size = UDim2.new(0, 22, 0, 22)
        preset.BackgroundColor3 = color
        preset.AutoButtonColor = false
        preset.Active = true
        preset.Parent = presetFrame

        local presetCorner = Instance.new("UICorner")
        presetCorner.CornerRadius = UDim.new(0, 11)
        presetCorner.Parent = preset

        preset.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                onChange(color)
            end
        end)
    end

    -- Логика пикера
    local hueVal = 0
    local satVal = 1
    local briVal = 1

    local function updateColor()
        local c = Color3.fromHSV(hueVal, satVal, briVal)
        onChange(c)
    end

    canvas.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            satVal = math.clamp(pos.X / canvas.AbsoluteSize.X, 0, 1)
            briVal = 1 - math.clamp(pos.Y / canvas.AbsoluteSize.Y, 0, 1)
            updateColor()
        end
    end)

    canvas.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            satVal = math.clamp(pos.X / canvas.AbsoluteSize.X, 0, 1)
            briVal = 1 - math.clamp(pos.Y / canvas.AbsoluteSize.Y, 0, 1)
            updateColor()
        end
    end)

    hueFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            hueVal = math.clamp((pos.X - hueFrame.AbsolutePosition.X) / hueFrame.AbsoluteSize.X, 0, 1)
            hueKnob.Position = UDim2.new(hueVal, 0, 0.5, 0)
            updateColor()
        end
    end)

    hueFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            hueVal = math.clamp((pos.X - hueFrame.AbsolutePosition.X) / hueFrame.AbsoluteSize.X, 0, 1)
            hueKnob.Position = UDim2.new(hueVal, 0, 0.5, 0)
            updateColor()
        end
    end)

    return container
end

