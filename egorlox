    else
        Notify("You don't have a gun!", Theme.RedNotif)
    end
end

local antiFlingLoop
local function ApplyAntiFling(state)
    mmState.antiFling = state
    if antiFlingLoop then antiFlingLoop:Disconnect() end
    if state then
        antiFlingLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local linVel = hrp.AssemblyLinearVelocity local angVel = hrp.AssemblyAngularVelocity
                    if linVel.Magnitude > 200 or angVel.Magnitude > 100 then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, linVel.Y, 0) hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end)
    end
end

local function KillAllPlayers()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local tool = char:FindFirstChildOfClass("Tool") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
    
    if not (tool and hum and hrp and tool.Name:lower():find("knife")) then
        Notify("You need a knife!", Theme.RedNotif)
        return
    end
    
    if tool.Parent == LocalPlayer.Backpack then hum:EquipTool(tool) task.wait(0.05) end
    
    local wasAntiFling = mmState.antiFling
    if wasAntiFling then ApplyAntiFling(false) end
    
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= LocalPlayer and target.Character then
            local tHum = target.Character:FindFirstChildOfClass("Humanoid")
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if tHum and tHrp and tHum.Health > 0 then
                local dist = (tHrp.Position - hrp.Position).Magnitude
                if dist < 500 then
                    hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 2)
                    tool:Activate()
                    task.wait(0.1)
                end
            end
        end
    end
    
    if wasAntiFling then ApplyAntiFling(true) end
    Notify("Killed everyone!", Theme.Success)
end

