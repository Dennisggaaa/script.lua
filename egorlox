    Create("UIStroke", {Color = Theme.DarkStroke, Thickness = 1, Parent = Container})
    Container.ClipsDescendants = true

    local Header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 65),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Parent = Container
    })
    AddRipple(Header)

    Create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 20),
        Position = UDim2.new(0, 15, 0, 12),
        BackgroundTransparency = 1,
        Text = L("FlingPlayer"),
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 15),
        Position = UDim2.new(0, 15, 0, 35),
        BackgroundTransparency = 1,
        Text = L("FlingPlayerDesc"),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Theme.Description,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header
    })

    local ToggleBtn = Create("TextButton", {
        Size = UDim2.new(0, 50, 0, 24),
        Position = UDim2.new(1, -65, 0.5, -12),
        BackgroundColor3 = Color3.fromRGB(10, 10, 12),
        AutoButtonColor = false,
        Text = "",
        Parent = Header
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ToggleBtn})
    local TogStroke = Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = ToggleBtn})
    local Indicator = Create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = ToggleBtn
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Indicator})
    
    local TogGlow = Create("ImageLabel", {
        Size = UDim2.new(1, 20, 1, 20),
        Position = UDim2.new(0, -10, 0, -10),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084",
        ImageColor3 = Theme.Accent,
        ImageTransparency = 1,
        Parent = ToggleBtn
    })

    local SubContainer = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 65),
        BackgroundColor3 = Color3.fromRGB(16, 16, 20),
        BorderSizePixel = 0,
        Parent = Container
    })
    Create("UIListLayout", {Padding = UDim.new(0, 8), Parent = SubContainer})
    Create("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = SubContainer})

    local state = mmState.isFlinging
    local expanded = mmState.isFlinging

    local function UpdateSize()
        local baseHeight = 65
        local subHeight = expanded and (SubContainer.UIListLayout.AbsoluteContentSize.Y + 20) or 0
        TweenService:Create(Container, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, baseHeight + subHeight)}):Play()
        TweenService:Create(SubContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, subHeight)}):Play()
    end

    if state then
        ToggleBtn.BackgroundColor3 = Theme.Accent
        TogStroke.Color = Theme.Accent
        Indicator.Position = UDim2.new(1, -21, 0.5, -9)
        Indicator.BackgroundColor3 = Theme.TextDark
        TogGlow.ImageTransparency = 0.5
    end

    AddRipple(ToggleBtn)
    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(ToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(TogStroke, TweenInfo.new(0.3), {Color = Theme.Accent}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -21, 0.5, -9), BackgroundColor3 = Theme.TextDark}):Play()
            TweenService:Create(TogGlow, TweenInfo.new(0.3), {ImageTransparency = 0.5}):Play()
            expanded = true
        else
            TweenService:Create(ToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(10, 10, 12)}):Play()
            TweenService:Create(TogStroke, TweenInfo.new(0.3), {Color = Theme.Stroke}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, -9), BackgroundColor3 = Theme.Text}):Play()
            TweenService:Create(TogGlow, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
            expanded = false
        end
        UpdateSize()
    end)

    local PlayerList = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 150),
        BackgroundColor3 = Color3.fromRGB(12, 12, 16),
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = SubContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = PlayerList})
    Create("UIListLayout", {Padding = UDim.new(0, 5), Parent = PlayerList})
    Create("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = PlayerList})
    PlayerList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        PlayerList.CanvasSize = UDim2.new(0, 0, 0, PlayerList.UIListLayout.AbsoluteContentSize.Y + 10)
    end)

    local ActionBtn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = Theme.Disabled,
        AutoButtonColor = false,
        Text = "Fling!",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Theme.Description,
        Active = false,
        Parent = SubContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ActionBtn})
    Create("UIStroke", {Color = Theme.DarkStroke, Thickness = 1, Parent = ActionBtn})
    AddRipple(ActionBtn)

    local function UpdateActionBtn()
        if mmState.isFlinging then
            TweenService:Create(ActionBtn, TweenInfo.new(0.3), {BackgroundColor3 = Theme.RedNotif, TextColor3 = Theme.Text}):Play()
            ActionBtn.Text = "Stop!"
            ActionBtn.Active = true
        elseif mmState.flingTarget then
            TweenService:Create(ActionBtn, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextDark}):Play()
            ActionBtn.Text = "Fling!"
            ActionBtn.Active = true
        else
            TweenService:Create(ActionBtn, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Disabled, TextColor3 = Theme.Description}):Play()
            ActionBtn.Text = "Fling!"
            ActionBtn.Active = false
        end
    end

    local function PopulatePlayers()
        for _, child in ipairs(PlayerList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local isSelected = (mmState.flingTarget == plr)
                local PlrBtn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = isSelected and Theme.Accent or Color3.fromRGB(20, 20, 26),
                    AutoButtonColor = false,
                    Text = "",
                    Parent = PlayerList
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = PlrBtn})
                Create("UIStroke", {Color = Theme.DarkStroke, Thickness = 1, Parent = PlrBtn})
                
                Create("TextLabel", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = plr.Name,
                    Font = Enum.Font.GothamSemibold,
                    TextSize = 13,
                    TextColor3 = isSelected and Theme.TextDark or Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = PlrBtn
                })
                
                AddRipple(PlrBtn)
                
                PlrBtn.MouseButton1Click:Connect(function()
                    if mmState.isFlinging then return end
                    mmState.flingTarget = plr
                    PopulatePlayers()
                    UpdateActionBtn()
                end)
            end
        end
    end

    PopulatePlayers()
    Players.PlayerAdded:Connect(PopulatePlayers)
    Players.PlayerRemoving:Connect(function(p)
        if mmState.flingTarget == p and mmState.isFlinging then
            StopFlinging()
        end
        PopulatePlayers()
        UpdateActionBtn()
    end)

    ActionBtn.MouseButton1Click:Connect(function()
        if not ActionBtn.Active then return end
        
        if mmState.isFlinging then
            StopFlinging()
            Notify("Fling stopped", Theme.Success)
        else
            if mmState.flingTarget then
                StartFlinging(mmState.flingTarget)
                Notify("Flinging " .. mmState.flingTarget.Name .. "!", Theme.Accent)
            end
        end
        UpdateActionBtn()
    end)
    
    UpdateActionBtn()
    if expanded then
        task.spawn(function()
            task.wait(0.1)
            UpdateSize()
        end)
    end
end

