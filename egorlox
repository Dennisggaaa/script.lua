    end

    local function UpdateSize()
        local baseHeight = 60
        local subHeight = expanded and (SubContainer.UIListLayout.AbsoluteContentSize.Y + 20) or 0
        TweenService:Create(Container, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, baseHeight + subHeight)}):Play()
        TweenService:Create(SubContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, subHeight)}):Play()
        if parentUpdate then task.delay(0.45, parentUpdate) end
    end

    if state or hasActiveOption then
        state = true expanded = true
        Switch.BackgroundColor3 = Theme.Accent
        Indicator.Position = UDim2.new(1, -23, 0.5, -10)
    end

    Header.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(Switch, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
            expanded = true
            if onToggle then onToggle(state) end
        else
            TweenService:Create(Switch, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = Theme.Disabled}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
            expanded = false
            if onToggle then onToggle(state) end
        end
        UpdateSize()
    end)

    for _, opt in ipairs(subOptions) do
        if opt.Type == "Button" then
            local SubFrame = Create("TextButton", {Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(25, 25, 32), BackgroundTransparency = 0.2, AutoButtonColor = false, Text = "", Parent = SubContainer})
            Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = SubFrame})
            Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = SubFrame})
            AddRipple(SubFrame)
            Create("TextLabel", {Size = UDim2.new(1, -80, 0, 15), Position = UDim2.new(0, 15, 0, 8), BackgroundTransparency = 1, Text = opt.Name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = SubFrame})
            Create("TextLabel", {Size = UDim2.new(1, -80, 0, 15), Position = UDim2.new(0, 15, 0, 25), BackgroundTransparency = 1, Text = opt.Desc, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.Description, TextXAlignment = Enum.TextXAlignment.Left, Parent = SubFrame})

            local ActionBtn = Create("TextButton", {Size = UDim2.new(0, 60, 0, 25), Position = UDim2.new(1, -75, 0.5, -12.5), BackgroundColor3 = Theme.Accent, AutoButtonColor = false, Text = "Execute", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.TextDark, Active = true, Parent = SubFrame})
            Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = ActionBtn})
            ActionBtn.MouseButton1Click:Connect(function() if opt.Callback then opt.Callback() end end)
        end
    end
    
    if state or hasActiveOption then
        task.spawn(function() task.wait(0.1) UpdateSize() end)
    end
end

