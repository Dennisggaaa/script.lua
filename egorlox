local function AnimateLoading(callback)
    local progress = 0
    for i = 1, 30 do
        progress = (i / 30) * 100
        progressFill.Size = UDim2.new(progress / 100, 0, 1, 0)
        percentLabel.Text = math.floor(progress) .. "%"
        if progress >= 100 then
            progressFill.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
        end
        wait(0.05 + math.random() * 0.05)
    end
    TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 1, 0)
    }):Play()
    percentLabel.Text = "100%"
    wait(0.4)
    if callback then callback() end
end

