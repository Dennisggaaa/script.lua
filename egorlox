    end)

    main.MouseEnter:Connect(function()
        if not expanded then Tween(main, {BackgroundColor3 = Theme.SlotHover}, 0.2) end
    end)
    main.MouseLeave:Connect(function()
        if not expanded then Tween(main, {BackgroundColor3 = Theme.Slot}, 0.2) end
    end)

    return container, AddSub
end

