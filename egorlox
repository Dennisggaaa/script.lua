-- ===== СИСТЕМА ДРАГА ПОД ТАЧ =====
local DragSystem = {}

function DragSystem.MakeDraggable(frame, onDragStart, onDragEnd, onTap)
    local dragState = {
        active = false,
        startPos = nil,
        offset = nil,
        touchStart = 0,
        touchStartPos = nil,
        moved = false
    }

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragState.active = true
            dragState.touchStart = tick()
            dragState.touchStartPos = Vector2.new(input.Position.X, input.Position.Y)
            dragState.offset = Vector2.new(input.Position.X, input.Position.Y) - frame.AbsolutePosition
            dragState.moved = false
            if onDragStart then onDragStart() end
        end
    end)

    frame.InputChanged:Connect(function(input)
        if dragState.active and input.UserInputType == Enum.UserInputType.Touch then
            local newPos = Vector2.new(input.Position.X, input.Position.Y)
            local delta = (newPos - dragState.touchStartPos).Magnitude
            if delta > 6 then
                dragState.moved = true
            end
            if dragState.moved then
                frame.Position = UDim2.new(0, newPos.X - dragState.offset.X, 0, newPos.Y - dragState.offset.Y)
            end
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch and dragState.active then
            dragState.active = false
            local duration = tick() - dragState.touchStart
            local endPos = Vector2.new(input.Position.X, input.Position.Y)
            local delta = (endPos - dragState.touchStartPos).Magnitude

            if not dragState.moved and duration < 0.35 and delta < 8 then
                -- Это был тап
                if onTap then onTap() end
            elseif dragState.moved then
                -- Это был драг
                if onDragEnd then onDragEnd(frame.AbsolutePosition) end
            end
        end
    end)

    return dragState
end

