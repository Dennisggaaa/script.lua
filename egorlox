-- ══════════════ ОСНОВНАЯ ЛОГИКА AIM-BOT ══════════════
local function GetClosestPlayer()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    
    local maxDistance = aimState.fov
    local bestTarget = nil
    local bestScore = math.huge
    
    local myPos = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
    if not myPos then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character.PrimaryPart then
            local targetPart = player.Character.PrimaryPart
            local targetPos = targetPart.Position
            
            if aimState.visCheck then
                local ray = Ray.new(myPos.Position, (targetPos - myPos.Position).Unit * 1000)
                local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
                if hit and not hit:IsDescendantOf(player.Character) then
                    continue
                end
            end
            
            local screenPos, onScreen = camera:WorldToScreenPoint(targetPos)
            if not onScreen then continue end
            
            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            
            if distance <= maxDistance and distance < bestScore then
                bestScore = distance
                bestTarget = player
            end
        end
    end
    
    return bestTarget
end

local function AimAtTarget()
    if not aimState.on then return end
    
    local target = GetClosestPlayer()
    if not target then return end
    
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local targetPart = target.Character and target.Character.PrimaryPart
    if not targetPart then return end
    
    local targetPos = targetPart.Position + Vector3.new(0, 1.5, 0)
    local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
    
    local smoothFactor = math.min(aimState.smoothness / 100, 0.95)
    local currentCFrame = camera.CFrame
    local lerpCFrame = currentCFrame:Lerp(targetCFrame, smoothFactor)
    
    camera.CFrame = lerpCFrame
end

local aimConnection
local function StartAimLoop()
    if aimConnection then aimConnection:Disconnect() end
    aimConnection = RunService.RenderStepped:Connect(function()
        if aimState.on then
            AimAtTarget()
        end
    end)
end
StartAimLoop()

-- ══════════════ ESP ЛОГИКА ══════════════
local espBoxes = {} -- Храним все боксы

local function CreateEspBox(player)
    if espBoxes[player] then return end
    
    local container = Instance.new("Frame")
    container.Name = "ESP_" .. player.Name
    container.Size = UDim2.new(0, 100, 0, 150)
    container.Position = UDim2.new(0, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.Visible = false
    container.Parent = GUI
    
    -- Основной бокс (незалитый)
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.Size = UDim2.new(1, 0, 1, 0)
    box.Position = UDim2.new(0, 0, 0, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = espState.color
    box.Parent = container
    
    -- Обводка для лучшей видимости
    local outline = Instance.new("UIStroke")
    outline.Color = espState.color
    outline.Thickness = 2
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = box
    
    espBoxes[player] = {
        container = container,
        box = box,
        outline = outline
    }
end

local function UpdateEspBoxes()
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    -- Обновляем существующие и создаем новые
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character.PrimaryPart then
            if not espBoxes[player] then
                CreateEspBox(player)
            end
            
            local espData = espBoxes[player]
            if espData then
                local char = player.Character
                local rootPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
                if rootPart then
                    local pos = rootPart.Position
                    local screenPos, onScreen = camera:WorldToScreenPoint(pos)
                    
                    if onScreen then
                        -- Получаем размеры персонажа (приблизительно)
                        local size = 4 -- Высота персонажа в студиях
                        local headPos = pos + Vector3.new(0, size/2, 0)
                        local feetPos = pos - Vector3.new(0, size/2, 0)
                        
                        local headScreen, _ = camera:WorldToScreenPoint(headPos)
                        local feetScreen, _ = camera:WorldToScreenPoint(feetPos)
                        
                        if headScreen and feetScreen then
                            local height = math.abs(feetScreen.Y - headScreen.Y)
                            local width = height * 0.35 -- Ширина бокса пропорционально высоте
                            
                            local centerX = screenPos.X
                            local topY = math.min(headScreen.Y, feetScreen.Y)
                            
                            -- Обновляем позицию и размер
                            espData.container.Position = UDim2.new(0, centerX - width/2, 0, topY)
                            espData.container.Size = UDim2.new(0, width, 0, height)
                            espData.container.Visible = espState.on and espState.box
                            
                            -- Обновляем цвет
                            espData.box.BorderColor3 = espState.color
                            espData.outline.Color = espState.color
                        end
                    else
                        espData.container.Visible = false
                    end
                else
                    espData.container.Visible = false
                end
            end
        else
            -- Игрок не в игре или это локальный
            if espBoxes[player] then
                espBoxes[player].container:Destroy()
                espBoxes[player] = nil
            end
        end
    end
    
    -- Удаляем боксы для игроков, которых больше нет
    for player, _ in pairs(espBoxes) do
        if not Players:FindFirstChild(player.Name) then
            espBoxes[player].container:Destroy()
            espBoxes[player] = nil
        end
    end
end

-- Запускаем обновление ESP
local espConnection
local function StartEspLoop()
    if espConnection then espConnection:Disconnect() end
    espConnection = RunService.RenderStepped:Connect(function()
        if espState.on and espState.box then
            UpdateEspBoxes()
        else
            -- Скрываем все боксы
            for _, data in pairs(espBoxes) do
                data.container.Visible = false
            end
        end
    end)
end
StartEspLoop()

