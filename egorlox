local menuOpen = false

local function OpenMenu()
    if menuOpen then return end
    menuOpen = true
    Overlay.Visible = true
    MF.Visible = true
    -- Начинаем как маленькая капля из позиции ватермарка
    local wmAbs = WM.AbsolutePosition
    local wmSz  = WM.AbsoluteSize
    local startX = wmAbs.X + wmSz.X/2
    local startY = wmAbs.Y + wmSz.Y/2
    MF.AnchorPoint = Vector2.new(0.5,0.5)
    MF.Position    = UDim2.new(0, startX, 0, startY)
    MF.Size        = UDim2.new(0, 40, 0, 40)
    MF.BackgroundTransparency = 0.6

    Tw(Overlay, {BackgroundTransparency=0.5}, 0.35):Play()
    -- Фаза 1: расширяем как каплю (высота растёт быстрее ширины)
    local t1 = Tw(MF, {
        Size = UDim2.new(0, CFG.MenuW, 0, 60),
        Position = UDim2.new(0.5,0, 0.5,0),
        BackgroundTransparency = 0,
    }, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    t1:Play()
    t1.Completed:Connect(function()
        -- Фаза 2: открываем полную высоту (Back для упругости)
        Tw(MF, {
            Size = UDim2.new(0, CFG.MenuW, 0, CFG.MenuH),
        }, 0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    end)
end

local function CloseMenu()
    if not menuOpen then return end
    menuOpen = false
    -- Фаза 1: сжимаем высоту обратно (Back inward)
    local wmAbs = WM.AbsolutePosition
    local wmSz  = WM.AbsoluteSize
    local tgtX  = wmAbs.X + wmSz.X/2
    local tgtY  = wmAbs.Y + wmSz.Y/2

    local t1 = Tw(MF, {
        Size = UDim2.new(0, CFG.MenuW, 0, 50),
    }, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    t1:Play()
    t1.Completed:Connect(function()
        -- Фаза 2: схлопываемся в точку ватермарка
        local t2 = Tw(MF, {
            Size     = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, tgtX, 0, tgtY),
            BackgroundTransparency = 0.7,
        }, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        t2:Play()
        Tw(Overlay,{BackgroundTransparency=1},0.22):Play()
        t2.Completed:Connect(function()
            MF.Visible = false
            Overlay.Visible = false
            -- Сброс позиции на центр для следующего открытия
            MF.Position = UDim2.new(0.5,0,0.5,0)
        end)
    end)
end

WM.MouseButton1Click:Connect(function()
    if menuOpen then CloseMenu() else OpenMenu() end
end)

