    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Switch})
    local Indicator = Create("Frame", {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 3, 0.5, -10), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = Switch})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Indicator})

    local SubContainer = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 60), BackgroundColor3 = Color3.fromRGB(15, 15, 20), BackgroundTransparency = 0.2, BorderSizePixel = 0, Parent = Container})
    Create("UIListLayout", {Padding = UDim.new(0, 8), Parent = SubContainer})
    Create("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = SubContainer})

    local state = defaultState or false
    local expanded = false
    local hasActiveOption = false
    for _, opt in ipairs(subOptions) do
        if opt.Default or (opt.Type == "Expandable" and (opt.DefaultState or opt.HasActive)) then hasActiveOption = true break end
    end

    local function UpdateSize()
        local baseHeight = 60
        local subHeight = expanded and (SubContainer.UIListLayout.AbsoluteContentSize.Y + 20) or 0
        TweenService:Create(Container, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, baseHeight + subHeight)}):Play()
        TweenService:Create(SubContainer, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, subHeight)}):Play()
        if parentUpdate then task.delay(0.5, parentUpdate) end
    end

    if state or hasActiveOption then
        state = true expanded = true
        Switch.BackgroundColor3 = Theme.Accent
        Indicator.Position = UDim2.new(1, -23, 0.5, -10)
    end

    Header.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(Switch, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
            expanded = true
            if onToggle then onToggle(state) end
        else
            TweenService:Create(Switch, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
            expanded = false
            if onToggle then onToggle(state) end
        end
        UpdateSize()
    end)

    for _, opt in ipairs(subOptions) do
        if opt.Type == "Button" then
            CreateButton(SubContainer, opt.Name, opt.Desc, opt.Callback)
        elseif opt.Type == "Expandable" then
            CreateExpandable(SubContainer, opt.Name, opt.Desc, opt.SubOptions, true, UpdateSize, opt.DefaultState, opt.onToggle)
        else
            local SubFrame = Create("TextButton", {Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(25, 25, 32), BackgroundTransparency = 0.2, AutoButtonColor = false, Text = "", Parent = SubContainer})
            Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = SubFrame})
            AddRipple(SubFrame)
            Create("TextLabel", {Size = UDim2.new(1, -80, 0, 15), Position = UDim2.new(0, 15, 0, 8), BackgroundTransparency = 1, Text = opt.Name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = SubFrame})
            Create("TextLabel", {Size = UDim2.new(1, -80, 0, 15), Position = UDim2.new(0, 15, 0, 25), BackgroundTransparency = 1, Text = opt.Desc, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.Description, TextXAlignment = Enum.TextXAlignment.Left, Parent = SubFrame})

            local SubSwitch = Create("Frame", {Size = UDim2.new(0, 38, 0, 22), Position = UDim2.new(1, -53, 0.5, -11), BackgroundColor3 = Color3.fromRGB(40, 40, 50), BorderSizePixel = 0, Parent = SubFrame})
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SubSwitch})
            local SubInd = Create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = SubSwitch})
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SubInd})

            local subState = opt.Default or false
            if subState then
                SubSwitch.BackgroundColor3 = Theme.Accent
                SubInd.Position = UDim2.new(1, -19, 0.5, -8)
            end

            SubFrame.MouseButton1Click:Connect(function()
                subState = not subState
                if subState then
                    TweenService:Create(SubSwitch, TweenInfo.new(0.4), {BackgroundColor3 = Theme.Accent}):Play()
                    TweenService:Create(SubInd, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
                else
                    TweenService:Create(SubSwitch, TweenInfo.new(0.4), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
                    TweenService:Create(SubInd, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
                end
                if opt.Callback then opt.Callback(subState) end
            end)
        end
    end
    
    if state or hasActiveOption then
        task.spawn(function() task.wait(0.1) UpdateSize() end)
    end
end

local function CreateColorSlider(page, title, desc, defaultColor, onColorChanged)
    local Container = Create("Frame", {Size = UDim2.new(1, 0, 0, 75), BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.2, Parent = page})
    Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = Container})
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 20, 0, 10), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 15), Position = UDim2.new(0, 20, 0, 32), BackgroundTransparency = 1, Text = desc, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.Description, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})

    local Bar = Create("TextButton", {Size = UDim2.new(1, -40, 0, 12), Position = UDim2.new(0, 20, 0, 55), BackgroundColor3 = defaultColor, AutoButtonColor = false, Text = "", Parent = Container})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Bar})
    Create("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))}), Parent = Bar})

    local Knob = Create("Frame", {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 0, 0.5, -10), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = Bar})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})

    local draggingSlider = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local color = Color3.fromHSV(pos, 0.8, 1)
        Knob.Position = UDim2.new(pos, -10, 0.5, -10)
        onColorChanged(color)
    end

    Bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true update(input) end end)
    Bar.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end end)
    UserInputService.InputChanged:Connect(function(input) if draggingSlider and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end end)
end

