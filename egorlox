        info = info .. "Murderer: " .. (murderer and murderer.Name or "Unknown") .. "\n"
        info = info .. "Sheriff: " .. (sheriff and sheriff.Name or "Unknown") .. "\n"
        info = info .. "Innocents: " .. #innocents .. "\n"
        info = info .. "Players: " .. #Players:GetPlayers() .. "\n"
