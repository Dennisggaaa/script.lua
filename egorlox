local isOpen = false
local function OpenMenu()
    isOpen = true; Menu.Visible = true
    Menu.Size = UDim2.new(0, CFG.MenuW*0.9, 0, CFG.MenuH*0.9)
    Menu.BackgroundTransparency = 1
    Tw(Menu, { Size = UDim2.new(0,CFG.MenuW,0,CFG.MenuH), BackgroundTransparency = 0 }, 0.28):Play()
end
local function CloseMenu()
    isOpen = false
    local t = Tw(Menu, { Size = UDim2.new(0,CFG.MenuW*0.9,0,CFG.MenuH*0.9), BackgroundTransparency = 1 }, 0.2)
    t:Play(); t.Completed:Wait(); Menu.Visible = false
end
wmBtn.MouseButton1Click:Connect(function()
    if isOpen then task.spawn(CloseMenu) else OpenMenu() end
end)
closeBtn.MouseButton1Click:Connect(function() task.spawn(CloseMenu) end)
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        if isOpen then task.spawn(CloseMenu) else OpenMenu() end
    end
end)

-- ══════════════ ПЕРЕТАСКИВАНИЕ ══════════════
local function MakeDrag(frame, handle)
    local dragging, startPos, startInput
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startInput = i.Position; startPos = frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end
