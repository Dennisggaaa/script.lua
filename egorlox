--// WINDOW / ISLAND MORPH
local function setWindowVisibility(visible)
    if visible then
        Window.Visible = true
        WindowScale.Scale = 0.90 * State.UIScale
        Window.BackgroundTransparency = 0.2

        tween(WindowScale, 0.48, {
            Scale = State.UIScale
        }, Enum.EasingStyle.Back)

        tween(Window, 0.35, {
            BackgroundTransparency = 0,
        }, Enum.EasingStyle.Quint)
    else
        tween(WindowScale, 0.28, {
            Scale = 0.92 * State.UIScale
        }, Enum.EasingStyle.Quint)

        tween(Window, 0.2, {
            BackgroundTransparency = 0.35,
        })

        task.delay(0.22, function()
            if not State.Open then
                Window.Visible = false
            end
        end)
    end
end

openWindow = function()
    if State.Open then return end
    State.Open = true

    tween(IslandScale, 0.30, {
        Scale = 0.86
    }, Enum.EasingStyle.Back)

    tween(Island, 0.34, {
        Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
        Position = UI.WindowPosition,
    }, Enum.EasingStyle.Quint)

    task.delay(0.16, function()
        if State.Open then
            Island.Visible = false
            setWindowVisibility(true)
        end
    end)
end

closeWindow = function()
    if not State.Open then return end
    State.Open = false

    Window.Visible = false
    Island.Visible = true
    Island.Position = UDim2.new(0.5, 0, 0, 12)
    Island.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)

    tween(IslandScale, 0.32, {
        Scale = 0.92
    }, Enum.EasingStyle.Quint)

    tween(Island, 0.40, {
        Size = UDim2.fromOffset(ISLAND_W, ISLAND_H),
    }, Enum.EasingStyle.Quint)

    task.delay(0.28, function()
        if not State.Open then
            tween(IslandScale, 0.20, {Scale = 1}, Enum.EasingStyle.Back)
        end
    end)
end

openIsland = function()
    if State.Open then
        closeWindow()
    else
        openWindow()
    end
end

Island.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        openIsland()
    end
end)

CloseButton.Activated:Connect(closeWindow)

--// DRAGGING
do
    local dragging = false
    local dragStart
    local startPos

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Window.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart
        Window.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

--// PARTICLE ENGINE
local particles = {}
local function createParticle()
    if not State.Particles then return end
    if State.Performance == "Performance" then return end

    local p = Instance.new("Frame")
    p.BackgroundColor3 = getAccent()
    p.BackgroundTransparency = 0.72
    p.BorderSizePixel = 0
    p.Size = UDim2.fromOffset(math.random(2, 4), math.random(2, 4))
    p.Position = UDim2.fromScale(math.random(), math.random())
    p.ZIndex = 3
    p.Parent = ParticleLayer
    corner(p, 10)

    table.insert(particles, {
        Object = p,
        Speed = math.random(3, 8),
        Phase = math.random() * math.pi * 2,
    })
end

for _ = 1, 12 do
    createParticle()
end

RunService.RenderStepped:Connect(function(dt)
    if not Window.Visible then return end

    for i = #particles, 1, -1 do
        local item = particles[i]
        local p = item.Object

        if not p.Parent then
            table.remove(particles, i)
        else
            local pos = p.Position
            local x = pos.X.Scale + math.sin(os.clock() * 0.25 + item.Phase) * dt * 0.008
            local y = pos.Y.Scale - dt * 0.002 * item.Speed

            if y < -0.05 then
                y = 1.05
                x = math.random()
            end

            p.Position = UDim2.fromScale(x, y)
        end
    end
end)

