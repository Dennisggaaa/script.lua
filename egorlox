local function ShootMurderer()
    local murderer = nil
    for _, p in ipairs(Players:GetPlayers()) do if playerRoles[p] == "Murderer" then murderer = p break end end
    if not murderer or not murderer.Character then Notify("Murderer not found", Theme.RedNotif) return end
    local mHumRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not mHumRoot then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p ~= murderer and playerRoles[p] == "Innocent" and p.Character then
            local pHumRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if pHumRoot and (pHumRoot.Position - mHumRoot.Position).Magnitude < 15 then
                Notify("There's an idiot standing next to the murder, wait until he moves away.", Theme.RedNotif)
                return
            end
        end
    end

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildOfClass("Tool") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
    
    if tool and hum and tool.Name:lower():find("gun") then
        if tool.Parent == LocalPlayer.Backpack then hum:EquipTool(tool) task.wait(0.2) end
