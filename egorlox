local function CreateColorSlider(page, title, desc, defaultColor, onColorChanged)
    local Container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 80),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Parent = page
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = Container})
    Create("UIStroke", {Color = Theme.DarkStroke, Thickness = 1, Parent = Container})

    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 15, 0, 10),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Container
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 15),
        Position = UDim2.new(0, 15, 0, 32),
        BackgroundTransparency = 1,
        Text = desc,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Theme.Description,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Container
    })

    local Bar = Create("TextButton", {
        Size = UDim2.new(1, -30, 0, 15),
        Position = UDim2.new(0, 15, 0, 58),
        BackgroundColor3 = defaultColor,
        AutoButtonColor = false,
        Text = "",
        Parent = Container
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Bar})

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 0, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = Bar
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})
    Create("UIStroke", {Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Parent = Knob})
    
    local KnobGlow = Create("ImageLabel", {
        Size = UDim2.new(1, 15, 1, 15),
        Position = UDim2.new(0, -7.5, 0, -7.5),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084",
        ImageColor3 = Theme.Accent,
        ImageTransparency = 0.5,
        Parent = Knob
    })

    local draggingSlider = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local color = Color3.fromHSV(pos, 0.8, 1)
        Bar.BackgroundColor3 = color
        Knob.Position = UDim2.new(pos, -10, 0.5, -10)
        KnobGlow.ImageColor3 = color
        onColorChanged(color)
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
            update(input)
        end
    end)
    Bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            update(input)
        end
    end)
end

