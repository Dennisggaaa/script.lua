local lastFireTime = 0
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDist = aimState.Fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local shortest3DDist = 500
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                
                local isVisible = true
                if aimState.VisibleCheck then
                    local ray = Ray.new(Camera.CFrame.Position, hrp.Position - Camera.CFrame.Position)
                    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, char})
                    isVisible = (hit == nil or hit:IsDescendantOf(char))
                end
                
                if isVisible then
                    if aimState.Aim360 then
                        local charHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if charHrp then
                            local dist3D = (hrp.Position - charHrp.Position).Magnitude
                            if dist3D < shortest3DDist then
                                shortest3DDist = dist3D
                                closestPlayer = plr
                            end
                        end
                    else
                        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local dist2D = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if dist2D < shortestDist then
                                closestPlayer = plr
                                shortestDist = dist2D
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

