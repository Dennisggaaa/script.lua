    CreateToggle(PageContainer, "Pulse Effect", "Enable rhythmic white glow pulsation on the UI.", function(state)
        isPulsing = state
        if state then
            task.spawn(function()
                while isPulsing do
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255)}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255)}):Play()
                    task.wait(0.8)
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Theme.Stroke}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Theme.Accent}):Play()
                    task.wait(0.8)
                end
            end)
        else
            TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Theme.Stroke}):Play()
            TweenService:Create(WmStroke, TweenInfo.new(0.3), {Color = Theme.Accent}):Play()
        end
    end)

    CreateCategory(PageContainer, "Theme Customization")
    CreateColorSlider(PageContainer, "Accent Color", "Change the main menu and UI accent color.", Theme.Accent, function(color)
        if not isPulsing then
            Theme.Accent = color
            PageContainer.ScrollBarImageColor3 = color
            PageTitle.TextColor3 = color -- можно сделать так чтобы заголовок был цветом акцента
            UserInfo.BottomDesc.TextColor3 = color
            
            for name, tab in pairs(Tabs) do
                if name == ActiveTab then
                    tab.Button.Title.TextColor3 = color
                    SlideIndicator.BackgroundColor3 = color
                end
            end
        end
    end)
end

