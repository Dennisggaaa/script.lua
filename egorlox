local function removeEspForPlayer(player)
    local data = espObjects[player]
    if data then data.gui:Destroy() espObjects[player] = nil end
end

local function updateEspForPlayer(player)
    local data = espObjects[player]
    if not data then return end
    if not espState.Enabled or not player.Character then data.gui.Visible = false return end
    local char = player.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hum or not hrp or not head or hum.Health <= 0 then data.gui.Visible = false return end

    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
    local footPos, footOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    if not headOnScreen and not footOnScreen then data.gui.Visible = false return end

    local height = math.abs(footPos.Y - headPos.Y)
    local width = height / 2
    local centerX = (headPos.X + footPos.X) / 2
    local topY = math.min(headPos.Y, footPos.Y)
    if height < 10 then data.gui.Visible = false return end

    data.gui.Visible = true

    if espState.Box then
        data.box.Visible = true
        data.box.Size = UDim2.new(0, width, 0, height)
        data.box.Position = UDim2.new(0, centerX - width / 2, 0, topY)
    else data.box.Visible = false end

    if espState.Health then
        data.healthBg.Visible = true
        data.healthText.Visible = true
        local barWidth = 3
        local barX = centerX - width / 2 - barWidth - 2
        data.healthBg.Size = UDim2.new(0, barWidth, 0, height)
        data.healthBg.Position = UDim2.new(0, barX, 0, topY)
        local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        data.healthFill.Size = UDim2.new(1, 0, healthPct, 0)
        data.healthText.Text = tostring(math.floor(hum.Health))
        data.healthText.Size = UDim2.new(0, 50, 0, 15)
        data.healthText.Position = UDim2.new(0, centerX - 25, 0, topY + height + 2)
    else
        data.healthBg.Visible = false
        data.healthText.Visible = false
    end

    if espState.Line then
        data.tracer.Visible = true
        local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        if espState.LinePos == "Top" then startPos = Vector2.new(Camera.ViewportSize.X / 2, 0)
        elseif espState.LinePos == "Bottom" then startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) end
        local endPos = Vector2.new(centerX, topY)
        local dist = (endPos - startPos).Magnitude
        local angle = math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X)
        data.tracer.Size = UDim2.new(0, dist, 0, 1)
        data.tracer.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
        data.tracer.Rotation = math.deg(angle)
    else data.tracer.Visible = false end
end

