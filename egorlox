        end
    end
    
    if state or hasActiveOption then
        task.spawn(function() task.wait(0.1) UpdateSize() end)
    end
end

local function CreateColorSlider(page, title, desc, defaultColor, onColorChanged)
    local Container = Create("Frame", {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Theme.Element, Parent = page})
    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = Container})
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 15, 0, 8), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 14), Position = UDim2.new(0, 15, 0, 24), BackgroundTransparency = 1, Text = desc, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.Description, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})

    local Bar = Create("TextButton", {Size = UDim2.new(1, -30, 0, 10), Position = UDim2.new(0, 15, 0, 45), BackgroundColor3 = defaultColor, AutoButtonColor = false, Text = "", Parent = Container})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Bar})
    Create("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))}), Parent = Bar})

    local Knob = Create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 0, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = Bar})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})
    Create("UIStroke", {Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Parent = Knob})

    local draggingSlider = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local color = Color3.fromHSV(pos, 0.8, 1)
        Knob.Position = UDim2.new(pos, -8, 0.5, -8)
        onColorChanged(color)
    end

    Bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true update(input) end end)
    Bar.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end end)
    UserInputService.InputChanged:Connect(function(input) if draggingSlider and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end end)
end

-- PLAYER SELECT MODULE (For Fling & Teleport)
local function CreatePlayerSelectModule(page, title, desc, defaultState, actionText, onAction)
    local Container = Create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = page})
    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = Container})
    Container.ClipsDescendants = true

    local Header = Create("TextButton", {Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = Container})
    Header.MouseEnter:Connect(function() TweenService:Create(Container, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play() end)
    Header.MouseLeave:Connect(function() TweenService:Create(Container, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Element}):Play() end)

    Create("TextLabel", {Size = UDim2.new(1, -80, 0, 16), Position = UDim2.new(0, 15, 0, 10), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Header})
    Create("TextLabel", {Size = UDim2.new(1, -80, 0, 14), Position = UDim2.new(0, 15, 0, 27), BackgroundTransparency = 1, Text = desc, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.Description, TextXAlignment = Enum.TextXAlignment.Left, Parent = Header})

    local Switch = Create("TextButton", {Size = UDim2.new(0, 34, 0, 16), Position = UDim2.new(1, -49, 0.5, -8), BackgroundColor3 = Theme.Disabled, AutoButtonColor = false, Text = "", Parent = Header})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Switch})
    local Indicator = Create("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Parent = Switch})
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Indicator})

    local SubContainer = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 50), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = Container})
    Create("UIListLayout", {Padding = UDim.new(0, 5), Parent = SubContainer})
    Create("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = SubContainer})

    local state = defaultState
    local expanded = false
    local selectedPlayer = nil

    local function UpdateSize()
        local baseHeight = 50
        local subHeight = expanded and (SubContainer.UIListLayout.AbsoluteContentSize.Y + 10) or 0
        TweenService:Create(Container, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, baseHeight + subHeight)}):Play()
        TweenService:Create(SubContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, subHeight)}):Play()
    end
    if state then
        Switch.BackgroundColor3 = Theme.Accent
        Indicator.Position = UDim2.new(1, -14, 0.5, -6) Indicator.BackgroundColor3 = Theme.TextDark
        expanded = true
    end
    Header.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(Switch, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Theme.TextDark}):Play()
            expanded = true
        else
            TweenService:Create(Switch, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Disabled}):Play()
            TweenService:Create(Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Theme.Text}):Play()
            expanded = false
        end
        UpdateSize()
    end)
    
    local PlayerList = Create("ScrollingFrame", {Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = Theme.Background, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(0, 0, 0, 0), Parent = SubContainer})
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = PlayerList})
    Create("UIListLayout", {Padding = UDim.new(0, 3), Parent = PlayerList})
    Create("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = PlayerList})
    PlayerList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() PlayerList.CanvasSize = UDim2.new(0, 0, 0, PlayerList.UIListLayout.AbsoluteContentSize.Y + 6) end)
    
    local ActionBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Disabled, AutoButtonColor = false, Text = actionText, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Description, Active = false, Parent = SubContainer})
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = ActionBtn})

    local function UpdateActionBtn()
        if selectedPlayer then
            TweenService:Create(ActionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextDark}):Play()
            ActionBtn.Active = true
        else
            TweenService:Create(ActionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Disabled, TextColor3 = Theme.Description}):Play()
            ActionBtn.Active = false
        end
    end

    local function PopulatePlayers()
        for _, child in ipairs(PlayerList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local isSelected = (selectedPlayer == plr)
                local PlrBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 25), BackgroundColor3 = isSelected and Theme.Accent or Theme.Element, AutoButtonColor = false, Text = "", Parent = PlayerList})
                Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = PlrBtn})
                Create("TextLabel", {Size = UDim2.new(1, -10, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = plr.Name, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = isSelected and Theme.TextDark or Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = PlrBtn})
                PlrBtn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    PopulatePlayers()
                    UpdateActionBtn()
                end)
            end
        end
    end
    PopulatePlayers()
    
    local addedConn = Players.PlayerAdded:Connect(PopulatePlayers)
    local removingConn = Players.PlayerRemoving:Connect(function(p)
        if selectedPlayer == p then selectedPlayer = nil UpdateActionBtn() end
        PopulatePlayers()
    end)
    PlayerList.Destroying:Connect(function()
        addedConn:Disconnect()
        removingConn:Disconnect()
    end)

    ActionBtn.MouseButton1Click:Connect(function()
        if ActionBtn.Active and selectedPlayer then onAction(selectedPlayer) end
    end)
    UpdateActionBtn()
    if state then task.spawn(function() task.wait(0.1) UpdateSize() end) end
end

