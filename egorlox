-- ══════════════ ROLE DETECTION (MM2) ══════════════
local function getRole(player)
    if not player or not player.Character then return nil end
    for _, tool in ipairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("blade") or name:find("dagger") then
                return "Murderer"
            elseif name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then
                return "Sheriff"
            end
        end
    end
    return nil
end

-- ══════════════ ESP / CHAMS SYSTEM ══════════════
local espObjects = {}

local function createEspForPlayer(player)
    if espObjects[player] then return espObjects[player] end

    local highlight = Instance.new("Highlight")
    highlight.Name = "Chams_" .. player.Name
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(0, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = nil

    espObjects[player] = {
        highlight = highlight,
    }
    return espObjects[player]
end

local function removeEspForPlayer(player)
    local data = espObjects[player]
    if data then
        if data.highlight then data.highlight:Destroy() end
        espObjects[player] = nil
    end
end

local function updateEspForPlayer(player)
    local data = espObjects[player]
    if not data then return end

    local role = getRole(player)
    local shouldHighlight = false
    local color = Color3.new(1, 1, 1)

    if role == "Murderer" and espState.chamsMurder then
        shouldHighlight = true
        color = Color3.fromRGB(255, 0, 64) -- Красный
    elseif role == "Sheriff" and espState.chamsSherif then
        shouldHighlight = true
        color = Color3.fromRGB(0, 170, 255) -- Синий
    end

    if shouldHighlight then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if data.highlight.Parent ~= player.Character then
                data.highlight.Parent = player.Character
            end
            data.highlight.Enabled = true
            data.highlight.FillColor = color
        else
            data.highlight.Enabled = false
        end
    else
        data.highlight.Enabled = false
    end
end

local espLoop
local function StartEspLoop()
    if espLoop then espLoop:Disconnect() end
    espLoop = RunService.RenderStepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not espObjects[player] then
                    createEspForPlayer(player)
                end
                updateEspForPlayer(player)
            end
        end

        for player, _ in pairs(espObjects) do
            if not Players:FindFirstChild(player.Name) then
                removeEspForPlayer(player)
            end
        end
    end)
end

Players.PlayerRemoving:Connect(function(player)
    removeEspForPlayer(player)
end)

StartEspLoop()

-- ══════════════ WALLSHOT HOOK ══════════════
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if method == "Raycast" and self == workspace and mmState.wallShot then
        local args = {...}
        local origin = args[1]
        local direction = args[2]
        local params = args[3] or RaycastParams.new()
        
        local newParams = RaycastParams.new()
        newParams.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}
        if params.FilterDescendantsInstances then
            for _, v in ipairs(params.FilterDescendantsInstances) do
                table.insert(filter, v)
            end
        end
        if LocalPlayer.Character then 
            table.insert(filter, LocalPlayer.Character) 
        end
        newParams.FilterDescendantsInstances = filter
        
        local currentOrigin = origin
        local remainingDir = direction
        
        -- Идём сквозь стены до 15 раз
        for i = 1, 15 do
            local result = oldNamecall(self, currentOrigin, remainingDir, newParams)
            if not result then return nil end
            
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChildOfClass("Humanoid") then
                return result
            else
                table.insert(filter, result.Instance)
                currentOrigin = result.Position
                remainingDir = origin + direction - currentOrigin
                if remainingDir.Magnitude < 0.1 then return nil end
            end
        end
        return oldNamecall(self, origin, direction, params)
    end
    return oldNamecall(self, ...)
end)

-- ══════════════ ANTI-FLING SYSTEM ══════════════
local antiFlingLoop
local function ApplyAntiFling(state)
    mmState.antiFling = state
    if antiFlingLoop then antiFlingLoop:Disconnect() end
    if state then
        antiFlingLoop = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local linVel = hrp.AssemblyLinearVelocity
                    local angVel = hrp.AssemblyAngularVelocity
                    
                    -- Если скорость слишком высокая (нас флингают)
                    if linVel.Magnitude > 200 or angVel.Magnitude > 100 then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, linVel.Y, 0)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end)
    end
end

