local function updateTabletScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local wanted = math.min(1, (viewport.X - 28) / 792, (viewport.Y - 70) / 512)
    mainScale.Scale = wanted
    shadowScale.Scale = wanted
end

local viewportConnection
local function connectViewport()
    if viewportConnection then viewportConnection:Disconnect() end
    if workspace.CurrentCamera then
        viewportConnection = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateTabletScale)
    end
    updateTabletScale()
end
