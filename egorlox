    local function getRole(player)
        local patterns = {murder={"knife","murder"}, sheriff={"gun","sheriff","revolver"}}
        local function scan(container)
            if not container then return nil end
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    for role, pats in pairs(patterns) do
                        for _, p in ipairs(pats) do
                            if n:find(p) then return role end
                        end
                    end
                end
            end
            return nil
        end
        local ch = player.Character
        local bp = player:FindFirstChild("Backpack")
        return scan(ch) or scan(bp) or "innocent"
    end

    local function applyChams()
        for _, p in ipairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local ch = p.Character
            if not ch then continue end
            local role  = getRole(p)
            local color = nil
            if role=="murder"   and Config.Toggles["chamsMurder"]  then color=Color3.fromRGB(255,0,64)    end
            if role=="sheriff"  and Config.Toggles["chamsSherif"]  then color=Color3.fromRGB(0,170,255)   end
            if role=="innocent" and Config.Toggles["chamsEnemies"] then color=Color3.fromRGB(0,255,0)     end

            local existing = ch:FindFirstChild("SC_HL")
            if color then
                if not existing then
                    existing = Instance.new("Highlight", ch)
                    existing.Name = "SC_HL"
                end
                existing.FillColor         = color
                existing.OutlineColor      = color
                existing.FillTransparency  = 0.48
                existing.OutlineTransparency = 0
            else
                if existing then existing:Destroy() end
            end
        end
    end

