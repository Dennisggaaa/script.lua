-- ЛОГИКА ВКЛАДОК
-- ========================================================================================
local Tabs = {}
local ActiveTab = nil

local function SelectTab(name)
    -- Очищаем текущую страницу
    for _, child in ipairs(PageContainer:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
    
    -- Обновляем визуал кнопок
    for tabName, tabData in pairs(Tabs) do
        if tabName == name then
            TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.3), {TextColor3 = Theme.TextDark}):Play()
            TweenService:Create(tabData.Button.Indicator, TweenInfo.new(0.3), {BackgroundColor3 = Theme.TextDark}):Play()
            TweenService:Create(tabData.Button.Indicator, TweenInfo.new(0.3), {Size = UDim2.new(0, 4, 0, 25)}):Play()
        else
            TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Element}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.3), {TextColor3 = Theme.Text}):Play()
            TweenService:Create(tabData.Button.Indicator, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(tabData.Button.Indicator, TweenInfo.new(0.3), {Size = UDim2.new(0, 4, 0, 15)}):Play()
        end
    end
    
    PageTitle.Text = name
    ActiveTab = name
    
    -- Вызываем функцию отрисовки страницы
    if Tabs[name].Render then
        Tabs[name].Render()
    end
end

local function CreateTab(name, isDefault)
    local Btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Element,
        AutoButtonColor = false,
        Text = "",
        Parent = TabContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Btn})
    
    local Indicator = Create("Frame", {
        Name = "Indicator",
        Size = UDim2.new(0, 4, 0, 15),
        Position = UDim2.new(0, 10, 0.5, -7.5),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = Btn
    }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
    
    local Title = Create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 25, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Btn
    })
    
    -- Hover эффект
    Btn.MouseEnter:Connect(function()
        if ActiveTab ~= name then
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play()
        end
    end)
    Btn.MouseLeave:Connect(function()
        if ActiveTab ~= name then
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Element}):Play()
        end
    end)
    
    Tabs[name] = {Button = Btn, Render = nil}
    
    Btn.MouseButton1Click:Connect(function()
        if name == "Aim-Bot" then
            Notify("not available yet", Theme.RedNotif)
            return
        end
        SelectTab(name)
    end)
    
    if isDefault then
        SelectTab(name)
    end
    
    return PageContainer
end

