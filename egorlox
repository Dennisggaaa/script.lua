CreateTab(L("Settings"))
Tabs[L("Settings")].Render = function()
    CreateCategory(PageContainer, L("VisualEffects"))
    local isPulsing = false
    CreateToggle(PageContainer, L("PulseEffect"), L("PulseEffectDesc"), false, function(state)
        isPulsing = state
        if state then
            task.spawn(function()
                while isPulsing do
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0}):Play()
                    task.wait(0.8)
                    TweenService:Create(MainStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Theme.Accent, Transparency = 0.2}):Play()
                    TweenService:Create(WmStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.8}):Play()
                    task.wait(0.8)
                end
            end)
        else
            TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Theme.Accent, Transparency = 0.2}):Play()
            TweenService:Create(WmStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.8}):Play()
        end
    end)
    CreateCategory(PageContainer, L("ThemeCustomization"))
    CreateToggle(PageContainer, L("Language"), L("LanguageDesc"), currentLang == "RUS", function(v)
        currentLang = v and "RUS" or "ENG"
        for name, tab in pairs(Tabs) do tab.Button.Title.Text = name end
        SelectTab(ActiveTab)
    end)
    CreateColorSlider(PageContainer, L("AccentColor"), L("AccentColorDesc"), Theme.Accent, function(color)
        if not isPulsing then
            Theme.Accent = color
            MainStroke.Color = color
            PageContainer.ScrollBarImageColor3 = color
            FovStroke.Color = color
            for name, tab in pairs(Tabs) do
                if name == ActiveTab then tab.Button.BackgroundColor3 = color end
            end
        end
    end)
    CreateColorSlider(PageContainer, L("WmTextColor"), L("WmTextColorDesc"), Theme.Text, function(color) WmText.TextColor3 = color end)
end

SelectTab(L("Settings"))
