--// DRAG (Menu)
local dragConn1, dragConn2, dragConn3
local dragging = false
local dragOffset

local function startDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local pos = input.Position
        dragOffset = Vector2.new(Menu.AbsolutePosition.X - pos.X, Menu.AbsolutePosition.Y - pos.Y)
    end
end

local function updateDrag(input)
    if dragging and dragOffset then
        local newPos = Vector2.new(input.Position.X + dragOffset.X, input.Position.Y + dragOffset.Y)
        Menu.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end
end

local function endDrag()
    dragging = false
end

Header.InputBegan:Connect(startDrag)
UserInputService.InputChanged:Connect(updateDrag)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        endDrag()
    end
end)

