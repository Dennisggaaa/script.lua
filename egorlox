    slotDesc.TextColor3 = Theme.TextDim
    slotDesc.TextSize = 12
    slotDesc.Font = Enum.Font.Gotham
    slotDesc.TextXAlignment = Enum.TextXAlignment.Left
    slotDesc.Parent = slot

    -- Toggle
    local toggleBg = Instance.new("TextButton")
    toggleBg.Size = UDim2.new(0, 52, 0, 28)
    toggleBg.Position = UDim2.new(1, -66, 0.5, -14)
    toggleBg.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    toggleBg.Text = ""
    toggleBg.AutoButtonColor = false
    toggleBg.Parent = slot

    Corner(toggleBg, 14)

    local toggleKnob = Instance.new("Frame")
    toggleKnob.Size = UDim2.new(0, 22, 0, 22)
    toggleKnob.Position = UDim2.new(0, 3, 0.5, -11)
    toggleKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
    toggleKnob.BorderSizePixel = 0
    toggleKnob.Parent = toggleBg

    Corner(toggleKnob, 11)

    local toggled = false
    toggleBg.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            Tween(toggleBg, {BackgroundColor3 = Theme.Green}, 0.2)
            Tween(toggleKnob, {Position = UDim2.new(0, 27, 0.5, -11), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}, 0.2)
        else
            Tween(toggleBg, {BackgroundColor3 = Color3.fromRGB(55, 55, 65)}, 0.2)
            Tween(toggleKnob, {Position = UDim2.new(0, 3, 0.5, -11), BackgroundColor3 = Color3.fromRGB(200, 200, 210)}, 0.2)
        end
    end)

    -- Hover effect
    slot.MouseEnter:Connect(function()
        Tween(slot, {BackgroundColor3 = Theme.BgLighter}, 0.2)
    end)
    slot.MouseLeave:Connect(function()
        Tween(slot, {BackgroundColor3 = Theme.BgLight}, 0.2)
    end)

    return slot
end

