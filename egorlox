function CreateSlider(parent, name, min, max, default, step, callback)
    step = step or 1
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -16, 0, 52)
    frame.BackgroundTransparency = 1
    frame.ZIndex = 60
    frame.Parent = parent
    
    local headerFrame = Instance.new("Frame")
    headerFrame.Size = UDim2.new(1, 0, 0, 20)
    headerFrame.BackgroundTransparency = 1
    headerFrame.ZIndex = 61
    headerFrame.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 180, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Colors.Text
    label.Font = Fonts.Normal
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 62
    label.Parent = headerFrame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 60, 1, 0)
    valueLabel.Position = UDim2.new(1, -60, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = Colors.AccentLight
    valueLabel.Font = Fonts.Mono
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 62
    valueLabel.Parent = headerFrame
    
    local sliderBg = Instance.new("TextButton")
    sliderBg.Size = UDim2.new(1, 0, 0, 8)
    sliderBg.Position = UDim2.new(0, 0, 0, 28)
    sliderBg.BackgroundColor3 = Colors.SliderBg
    sliderBg.BorderSizePixel = 0
    sliderBg.Text = ""
    sliderBg.AutoButtonColor = false
    sliderBg.ZIndex = 61
    sliderBg.Parent = frame
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame")
    local percent = (default - min) / (max - min)
    fill.Size = UDim2.new(percent, 0, 1, 0)
    fill.BackgroundColor3 = Colors.SliderFill
    fill.BorderSizePixel = 0
    fill.ZIndex = 62
    fill.Parent = sliderBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob2 = Instance.new("Frame")
    knob2.Size = UDim2.new(0, 14, 0, 14)
    knob2.Position = UDim2.new(percent, -7, 0.5, -7)
    knob2.BackgroundColor3 = Colors.White
    knob2.BorderSizePixel = 0
    knob2.ZIndex = 63
    knob2.Parent = sliderBg
    Instance.new("UICorner", knob2).CornerRadius = UDim.new(1, 0)
    
    SliderValues[name] = default
    
    local dragging = false
    local function update(input)
        local pos = input.Position
        local absPos = sliderBg.AbsolutePosition.X
        local absSize = sliderBg.AbsoluteSize.X
        local pct = math.clamp((pos.X - absPos) / absSize, 0, 1)
        local val = min + (max - min) * pct
        if step > 0 then val = math.floor(val / step + 0.5) * step end
        val = math.clamp(val, min, max)
        pct = (val - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob2.Position = UDim2.new(pct, -7, 0.5, -7)
        valueLabel.Text = tostring(val)
        SliderValues[name] = val
        callback(val)
    end
    
    sliderBg.MouseButton1Down:Connect(function()
        dragging = true
        update({Position = Vector2.new(Mouse.X, Mouse.Y)})
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return frame
end

function CreateDropdown(parent, name, options, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -16, 0, 38)
    frame.BackgroundTransparency = 1
    frame.ZIndex = 60
    frame.Parent = parent
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = Colors.Secondary
    btn.BorderSizePixel = 0
    btn.Text = "  " .. name .. ": " .. (default or options[1])
    btn.TextColor3 = Colors.Text
    btn.Font = Fonts.Normal
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.ZIndex = 61
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.Position = UDim2.new(0, 0, 1, 2)
    listFrame.BackgroundColor3 = Colors.Main
    listFrame.BorderSizePixel = 0
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #options * 30)
    listFrame.ScrollBarThickness = 3
    listFrame.Visible = false
    listFrame.ZIndex = 65
    listFrame.Parent = frame
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 5)
    
    local isOpen = false
    
    local function toggleList()
        isOpen = not isOpen
        if isOpen then
            listFrame.Visible = true
            Tween(listFrame, {Size = UDim2.new(1, 0, 0, math.min(#options * 32 + 4, 180))}, 0.2)
        else
            Tween(listFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
            wait(0.2)
            listFrame.Visible = false
        end
    end
    
    btn.MouseButton1Click:Connect(toggleList)
    
    for _, option in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, -6, 0, 28)
        optBtn.BackgroundColor3 = Colors.Secondary
        optBtn.BorderSizePixel = 0
        optBtn.Text = option
        optBtn.TextColor3 = Colors.Text
        optBtn.Font = Fonts.Normal
        optBtn.TextSize = 12
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 66
        optBtn.Parent = listFrame
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
        
        optBtn.MouseButton1Click:Connect(function()
            btn.Text = "  " .. name .. ": " .. option
            DropdownValues[name] = option
            toggleList()
            callback(option)
        end)
        
        optBtn.MouseEnter:Connect(function()
            Tween(optBtn, {BackgroundColor3 = Colors.Accent}, 0.1)
