    local dragging, dStart, dOrigPos = false, nil, nil
    local conns = {}
    table.insert(conns, btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dStart = inp.Position; dOrigPos = btn.Position
        end
    end))
    table.insert(conns, btn.InputChanged:Connect(function(inp)
