-- Адаптивное масштабирование под экран телефона
local function AdjustForMobile()
    local screenSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1080, 1920)

    -- Если экран меньше 800px по ширине — уменьшаем меню
    if screenSize.X < 800 then
        Menu.Size = UDim2.new(0, screenSize.X - 20, 0, screenSize.Y - 100)
        Menu.Position = UDim2.new(0, 10, 0, 50)
        Watermark.Size = UDim2.new(0, 190, 0, 32)
        WMTitle.TextSize = 12
        WMTime.TextSize = 10
    end
end

AdjustForMobile()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(AdjustForMobile)
