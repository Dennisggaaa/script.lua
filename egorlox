local playerRoles = {}

local function detectRole(player)
    if not player then return nil end
    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("blade") or name:find("dagger") then return "Murderer" end
                if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then return "Sheriff" end
            end
        end
    end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("blade") or name:find("dagger") then return "Murderer" end
                if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then return "Sheriff" end
            end
        end
    end
    return "Innocent"
end

local function setupRoleReset(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        playerRoles[player] = nil
    end)
end

for _, p in ipairs(Players:GetPlayers()) do setupRoleReset(p) end
Players.PlayerAdded:Connect(setupRoleReset)
