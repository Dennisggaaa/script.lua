--// CREATE TAB
local function MakeTab(data)
    local btn = Instance.new("TextButton")
    btn.Name = data.Name .. "Tab"
    btn.Size = UDim2.new(1, -20, 0, 46)
    btn.BackgroundColor3 = Theme.Bg
    btn.Text = "  " .. data.Name
    btn.TextColor3 = Theme.TextDim
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.LayoutOrder = data.Layout
    btn.Parent = Sidebar

    Corner(btn, 10)

    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Size = UDim2.new(0, 3, 0, 0)
    indicator.Position = UDim2.new(0, 0, 0.5, 0)
    indicator.AnchorPoint = Vector2.new(0, 0.5)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.Parent = btn

    Corner(indicator, 2)

    -- Content frame
    local frame = Instance.new("ScrollingFrame")
    frame.Name = data.Name .. "Content"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.ScrollBarThickness = 4
    frame.ScrollBarImageColor3 = Theme.Accent
    frame.ScrollBarImageTransparency = 0.5
    frame.Visible = false
    frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    frame.Parent = Content

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 12)
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = frame

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.Parent = frame

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        frame.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20)
    end)

    TabBtns[data.Name] = btn
    TabContents[data.Name] = frame

    -- Click
    btn.MouseButton1Click:Connect(function()
        if ActiveTab == data.Name then return end

        -- Deactivate old
        if ActiveTab then
            local oldBtn = TabBtns[ActiveTab]
            Tween(oldBtn, {BackgroundColor3 = Theme.Bg, TextColor3 = Theme.TextDim}, 0.2)
            Tween(oldBtn.Indicator, {Size = UDim2.new(0, 3, 0, 0)}, 0.2)
            TabContents[ActiveTab].Visible = false
        end

        -- Activate new
        ActiveTab = data.Name
        Tween(btn, {BackgroundColor3 = Theme.BgLighter, TextColor3 = Theme.Text}, 0.2)
        Tween(indicator, {Size = UDim2.new(0, 3, 0, 24)}, 0.25, Enum.EasingStyle.Back)
        frame.Visible = true
    end)

    return frame
end

