local function removeEspForPlayer(player)
    local data = espObjects[player]
    if data then
        if data.container then data.container:Destroy() end
        if data.highlight then data.highlight:Destroy() end
        espObjects[player] = nil
    end
end

local function updateEspForPlayer(player)
    local data = espObjects[player]
    if not data then return end

    if not espState.on or not isAlive(player) then
        data.container.Visible = false
        if data.highlight then data.highlight.Enabled = false end
        return
    end

    -- Team check
    if espState.teamCheck and isTeammate(player) then
        data.container.Visible = false
        if data.highlight then data.highlight.Enabled = false end
        return
    end

    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not head or not root or not humanoid then return end

    local camera = workspace.CurrentCamera
    local headPos, headOnScreen = camera:WorldToViewportPoint(head.Position)
    local rootPos, rootOnScreen = camera:WorldToViewportPoint(root.Position)
    local feetPos, feetOnScreen = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

    if not headOnScreen and not feetOnScreen then
        data.container.Visible = false
        if data.highlight then data.highlight.Enabled = false end
        return
    end

    local color = getEspColor(player)

    -- Box
    if espState.box then
        local topY = headPos.Y
        local bottomY = feetPos.Y
        local height = math.abs(bottomY - topY)
        local width = height * 0.45

        if height < 5 then
            data.container.Visible = false
        else
            local centerX = (headPos.X + rootPos.X) / 2
            data.container.Position = UDim2.new(0, centerX - width/2, 0, topY)
            data.container.Size = UDim2.new(0, width, 0, height)
            data.container.Visible = true
            data.boxStroke.Color = color
            data.nameLabel.Text = player.Name
            data.nameLabel.TextColor3 = color

            -- Distance
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if localRoot then
                local dist = math.floor((root.Position - localRoot.Position).Magnitude)
                data.distLabel.Text = dist .. "m"
            end
        end
    else
        data.container.Visible = false
    end

    -- Chams через Highlight
    if espState.chams then
        if data.highlight.Parent ~= char then
            data.highlight.Parent = char
        end
        data.highlight.Enabled = true
        data.highlight.FillColor = color
        data.highlight.OutlineColor = Color3.new(0, 0, 0)
        data.highlight.FillTransparency = 0.5
        data.highlight.OutlineTransparency = 0
    else
        data.highlight.Enabled = false
    end
end

local espLoop
local function StartEspLoop()
    if espLoop then espLoop:Disconnect() end
    espLoop = RunService.RenderStepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not espObjects[player] then
                    createEspForPlayer(player)
                end
                updateEspForPlayer(player)
            end
        end

        -- Cleanup
        for player, _ in pairs(espObjects) do
            if not Players:FindFirstChild(player.Name) then
                removeEspForPlayer(player)
            end
        end
    end)
end

-- Cleanup on death/leave
Players.PlayerRemoving:Connect(function(player)
    removeEspForPlayer(player)
end)

StartEspLoop()

