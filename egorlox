local function Tw(obj, props, dur, sty, dir)
    return TweenService:Create(obj,
        TweenInfo.new(dur or CFG.Spd, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props)
end
local function Corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 10); c.Parent = p; return c
end
local function Stroke(p, col, th)
    local s = Instance.new("UIStroke"); s.Color = col or CFG.Sep
    s.Thickness = th or 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p; return s
end
local function Pad(p, t, b, l, r)
    local u = Instance.new("UIPadding")
    u.PaddingTop=UDim.new(0,t or 10); u.PaddingBottom=UDim.new(0,b or 10)
    u.PaddingLeft=UDim.new(0,l or 10); u.PaddingRight=UDim.new(0,r or 10)
    u.Parent=p; return u
end
local function Lbl(parent, text, sz, col, font, xal)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency=1; l.Size=sz or UDim2.new(1,0,0,20)
    l.Text=text or ""; l.TextColor3=col or CFG.TxtPri
    l.TextSize=14; l.Font=font or Enum.Font.GothamMedium
    l.TextXAlignment=xal or Enum.TextXAlignment.Left
    l.RichText=true; l.Parent=parent; return l
end
local function GetTime()
    local h = tonumber(os.date("%H")); local m = os.date("%M")
    return string.format("%02d:%s", h, m)
end

