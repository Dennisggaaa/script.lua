                Size = UDim2.new(0, 58, 0, 58), Position = UDim2.new(0, 14, 0.5, -29), BackgroundTransparency = 0.92
            }):Play()
            wait(1.2)
        end
    end)

    spawn(function()
        while wm.AccentLine and wm.AccentLine.Parent do
            for hue = 0.54, 0.66, 0.002 do
                wm.AccentLine.BackgroundColor3 = Color3.fromHSV(hue, 0.85, 1)
                wait(0.03)
            end
        end
    end)

    spawn(function()
        while wm.LiveDot and wm.LiveDot.Parent do
            TweenService:Create(wm.LiveDotGlow, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(1, -40, 0, 4), BackgroundTransparency = 0.65
            }):Play()
