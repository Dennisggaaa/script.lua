            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SubSwitch})
            local SubInd = Create("Frame", {Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Parent = SubSwitch})
