local function AdjustForMobile()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local ss = camera.ViewportSize
    if ss.X < 800 then
        Menu.Size = UDim2.new(0, math.max(ss.X - 20, 320), 0, math.max(ss.Y - 100, 420))
        Menu.Position = UDim2.new(0, 10, 0, 50)
        Watermark.Size = UDim2.new(0, 190, 0, 32)
        WMTitle.TextSize = 12
        WMTime.TextSize = 10
    end
end
AdjustForMobile()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(AdjustForMobile)
