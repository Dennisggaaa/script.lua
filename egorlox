--// TOGGLE
local function createToggle(parent, titleText, subtitleText, initial, callback)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 58)
    row.Parent = parent

    local titleLabel = text(row, titleText, 12, Theme.Text, Enum.Font.GothamMedium)
    titleLabel.Position = UDim2.fromOffset(0, 3)
    titleLabel.Size = UDim2.new(1, -76, 0, 24)

    local sub = text(row, subtitleText or "", 10, Theme.Muted, Enum.Font.Gotham)
    sub.Position = UDim2.fromOffset(0, 26)
    sub.Size = UDim2.new(1, -76, 0, 20)

    local toggle = Instance.new("TextButton")
    toggle.AutoButtonColor = false
    toggle.Text = ""
    toggle.AnchorPoint = Vector2.new(1, 0.5)
    toggle.Position = UDim2.new(1, 0, 0.5, 0)
    toggle.Size = UDim2.fromOffset(48, 26)
    toggle.BackgroundColor3 = Theme.Background
    toggle.BorderSizePixel = 0
    toggle.Parent = row
    corner(toggle, 13)
    stroke(toggle, Theme.Border, 0.15, 1)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(20, 20)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 3, 0.5, 0)
    knob.BackgroundColor3 = Theme.Secondary
    knob.BorderSizePixel = 0
    knob.Parent = toggle
    corner(knob, 10)

    local enabled = initial == true

    local function render(animated)
        local targetX = enabled and 25 or 3
        local targetColor = enabled and getAccent() or Theme.Background
        local knobColor = enabled and Color3.new(1, 1, 1) or Theme.Secondary

        if animated then
            tween(toggle, 0.22, {BackgroundColor3 = targetColor})
            tween(knob, 0.22, {
                Position = UDim2.new(0, targetX, 0.5, 0),
                BackgroundColor3 = knobColor,
            }, Enum.EasingStyle.Back)
        else
            toggle.BackgroundColor3 = targetColor
            knob.Position = UDim2.new(0, targetX, 0.5, 0)
            knob.BackgroundColor3 = knobColor
        end
    end

    toggle.Activated:Connect(function()
        enabled = not enabled
        render(true)
        if callback then
            callback(enabled)
        end
    end)

    render(false)

    return {
        Row = row,
        Set = function(value, animated)
            enabled = value == true
            render(animated ~= false)
            if callback then callback(enabled) end
        end,
        Get = function()
            return enabled
        end,
    }
end

