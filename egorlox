        SendNotification("ℹ️", "MM2", "Info copied to clipboard!", 2)
    end)
    
    CreateToggle(mm2Content, "Round Notifications", true, function(v) ToggleStates.MM2RoundNotifs = v end)
    CreateToggle(mm2Content, "Murderer Alert Sound", false, function(v) ToggleStates.MM2MurdererAlert = v end)
    
    return mm2Content
end

