    end
end)

-- Упрощённый вариант: отдельный обработчик тапа без конфликта с драгом
local wmTouchStart = 0
local wmTouchStartPos = nil
local wmIsDragging = false

Watermark.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        wmTouchStart = tick()
        wmTouchStartPos = Vector2.new(input.Position.X, input.Position.Y)
        wmIsDragging = false
    end
end)

Watermark.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and not WatermarkLocked then
        local pos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = (pos - wmTouchStartPos).Magnitude
        if delta > 6 then
            wmIsDragging = true
        end
        if wmIsDragging then
            local offset = wmTouchStartPos - Watermark.AbsolutePosition
            Watermark.Position = UDim2.new(0, pos.X - offset.X, 0, pos.Y - offset.Y)
        end
    end
end)

Watermark.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local duration = tick() - wmTouchStart
        local endPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = (endPos - wmTouchStartPos).Magnitude
        if not wmIsDragging and duration < 0.35 and delta < 8 then
            -- ТАП
            MenuOpen = not MenuOpen
            Menu.Visible = MenuOpen
            if MenuOpen then
                SwitchTab(SettingsTab)
            end
        end
        wmIsDragging = false
    end
end)

-- Драг меню (через Header)
local menuTouchStart = 0
local menuTouchStartPos = nil
local menuIsDragging = false
local menuStartPosition = nil

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        menuTouchStart = tick()
        menuTouchStartPos = Vector2.new(input.Position.X, input.Position.Y)
        menuStartPosition = Menu.AbsolutePosition
        menuIsDragging = false
    end
end)

Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local pos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = (pos - menuTouchStartPos).Magnitude
        if delta > 6 then
            menuIsDragging = true
        end
        if menuIsDragging and menuStartPosition then
            local dx = pos.X - menuTouchStartPos.X
            local dy = pos.Y - menuTouchStartPos.Y
            Menu.Position = UDim2.new(0, menuStartPosition.X + dx, 0, menuStartPosition.Y + dy)
        end
    end
end)

Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and menuIsDragging then
        -- Создаём след
        CreateTrail(SeraphiCA, Menu.AbsolutePosition, Menu.Size, MenuColor)
        menuIsDragging = false
    end
end)

