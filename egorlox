    tgBg.Position = UDim2.new(1, -72, 0.5, -15)
    tgBg.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
    tgBg.Text = ""
    tgBg.AutoButtonColor = false
    tgBg.Parent = slot

    Corner(tgBg, 15)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 24, 0, 24)
    knob.Position = UDim2.new(0, 3, 0.5, -12)
    knob.BackgroundColor3 = Color3.fromRGB(210, 210, 220)
    knob.BorderSizePixel = 0
    knob.Parent = tgBg

    Corner(knob, 12)

    local on = false
    tgBg.MouseButton1Click:Connect(function()
        on = not on
        if on then
            Tween(tgBg, {BackgroundColor3 = Theme.Green}, 0.25)
            Tween(knob, {Position = UDim2.new(0, 29, 0.5, -12), BackgroundColor3 = Color3.fromRGB(255,255,255)}, 0.25)
            Stroke(slot, Theme.Green, 1, 0.5)
        else
            Tween(tgBg, {BackgroundColor3 = Color3.fromRGB(50, 50, 62)}, 0.25)
            Tween(knob, {Position = UDim2.new(0, 3, 0.5, -12), BackgroundColor3 = Color3.fromRGB(210, 210, 220)}, 0.25)
            Stroke(slot, Theme.Border, 1, 0.35)
        end
    end)

    slot.MouseEnter:Connect(function()
        if not on then
            Tween(slot, {BackgroundColor3 = Theme.BgSlotHover}, 0.2)
        end
    end)
    slot.MouseLeave:Connect(function()
        if not on then
            Tween(slot, {BackgroundColor3 = Theme.BgSlot}, 0.2)
        end
    end)

    return slot, tgBg
end

