function Watermark:StartEffects(wm)
    spawn(function()
        while wm.OuterGlow1 and wm.OuterGlow1.Parent do
            TweenService:Create(wm.OuterGlow1, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.8, Size = UDim2.new(1, 18, 1, 18), Position = UDim2.new(0, -9, 0, -9)
            }):Play()
            TweenService:Create(wm.OuterGlow2, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.88, Size = UDim2.new(1, 28, 1, 28), Position = UDim2.new(0, -14, 0, -14)
            }):Play()
            wait(1.5)
            TweenService:Create(wm.OuterGlow1, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.85, Size = UDim2.new(1, 12, 1, 12), Position = UDim2.new(0, -6, 0, -6)
