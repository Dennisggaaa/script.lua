-- WALLSHOT & FORCE TARGET HOOK
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    
    if mmState.forceTarget then
        if method == "FireServer" and self:IsA("Tool") then
            local args = {...}
            for i = 1, #args do
                if typeof(args[i]) == "Instance" and args[i]:IsA("BasePart") then
                    args[i] = mmState.forceTarget
                elseif typeof(args[i]) == "Vector3" then
                    args[i] = mmState.forceTarget.Position
                end
            end
            return oldNamecall(self, unpack(args))
        elseif self == workspace and method == "Raycast" then
            local result = Instance.new("RaycastResult")
            result.Instance = mmState.forceTarget
            result.Position = mmState.forceTarget.Position
            result.Normal = Vector3.new(0, 1, 0)
            result.Material = Enum.Material.Plastic
            return result
        elseif self == workspace and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") then
            return mmState.forceTarget, mmState.forceTarget.Position, Vector3.new(0, 1, 0)
        end
    end
    
    if mmState.wallShot then
        if method == "FireServer" and self:IsA("Tool") then
            local toolName = self.Name:lower()
            if toolName:find("gun") or toolName:find("revolver") or toolName:find("pistol") or toolName:find("colt") then
                local closestPart = nil
                local closestDist = math.huge
                local camera = workspace.CurrentCamera
                local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local char = plr.Character
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            for _, partName in ipairs({"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}) do
                                local part = char:FindFirstChild(partName)
                                if part then
                                    local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                                    if onScreen then
                                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                        if dist < closestDist then
                                            closestDist = dist
                                            closestPart = part
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if closestPart then
                    local args = {...}
                    for i = 1, #args do
                        if typeof(args[i]) == "Instance" and args[i]:IsA("BasePart") then
                            args[i] = closestPart
                        elseif typeof(args[i]) == "Vector3" then
                            args[i] = closestPart.Position
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        elseif self == workspace and method == "Raycast" then
            local args = {...}
            local origin = args[1]
            local direction = args[2]
            local params = args[3] or RaycastParams.new()
            
            local newParams = RaycastParams.new()
            newParams.FilterType = Enum.RaycastFilterType.Exclude
            local filter = {}
            if params.FilterDescendantsInstances then
                for _, v in ipairs(params.FilterDescendantsInstances) do table.insert(filter, v) end
            end
            if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
            newParams.FilterDescendantsInstances = filter
            
            local currentOrigin = origin
            local remainingDir = direction
            local lastResult = nil
            for i = 1, 15 do
                local result = oldNamecall(self, currentOrigin, remainingDir, newParams)
                if not result then break end
                lastResult = result
                local model = result.Instance:FindFirstAncestorOfClass("Model")
                if model and model:FindFirstChildOfClass("Humanoid") then
                    return result
                else
                    table.insert(filter, result.Instance)
                    currentOrigin = result.Position
                    remainingDir = origin + direction - currentOrigin
                    if remainingDir.Magnitude < 0.1 then break end
                end
            end
            if lastResult then return lastResult end
            return oldNamecall(self, origin, direction, params)
        elseif self == workspace and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") then
            local args = {...}
            local ray = args[1]
            local originalIgnoreList = args[2] or {}
            local ignoreList = {}
            for _, v in ipairs(originalIgnoreList) do table.insert(ignoreList, v) end
            if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
            
            local currentOrigin = ray.Origin
            local remainingDir = ray.Direction
            local lastPart, lastPos, lastNormal = nil, nil, nil
            for i = 1, 15 do
                local newRay = Ray.new(currentOrigin, remainingDir)
                local part, pos, normal
                if method == "FindPartOnRay" then
                    part, pos, normal = oldNamecall(self, newRay)
                else
                    part, pos, normal = oldNamecall(self, newRay, ignoreList, args[3], args[4])
                end
                if not part then break end
                lastPart, lastPos, lastNormal = part, pos, normal
                local model = part:FindFirstAncestorOfClass("Model")
                if model and model:FindFirstChildOfClass("Humanoid") then
                    return part, pos, normal
                else
                    table.insert(ignoreList, part)
                    currentOrigin = pos
                    remainingDir = ray.Origin + ray.Direction - currentOrigin
                    if remainingDir.Magnitude < 0.1 then break end
                end
            end
            if lastPart then return lastPart, lastPos, lastNormal end
            return oldNamecall(self, ray, originalIgnoreList, args[3], args[4])
        end
    end
    
    return oldNamecall(self, ...)
end
setreadonly(mt, true)

-- GUN FINDER & TP
local function FindGun()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") then
            local name = obj.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then
                if obj.Parent == Workspace or obj.Parent:IsA("Model") then
                    local handle = obj:FindFirstChild("Handle")
                    if handle then return obj, handle end
                end
            end
        end
    end
    return nil, nil
end

local function TpToGunAndPickUp()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tool, handle = FindGun()
    if tool and handle then
        local originalCFrame = hrp.CFrame
        hrp.CFrame = handle.CFrame * CFrame.new(0, 0, -2)
        task.wait(0.05) firetouchinterest(hrp, handle, 0) task.wait(0.05) firetouchinterest(hrp, handle, 1) task.wait(0.05)
        hrp.CFrame = originalCFrame
        Notify("Gun picked up!", Theme.Success)
    else Notify("No gun found on the ground", Theme.RedNotif) end
end

local autoPickUpConnection
local function ApplyAutoPickUpGun(state)
    mmState.autoPickUpGun = state
    if autoPickUpConnection then autoPickUpConnection:Disconnect() end
    if state then
        autoPickUpConnection = Workspace.DescendantAdded:Connect(function(child)
            if child:IsA("Tool") then
                local name = child.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("colt") then
                    task.spawn(function()
                        local handle = child:FindFirstChild("Handle") or child:WaitForChild("Handle", 2)
                        local char = LocalPlayer.Character
                        if handle and char then
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hrp and hum and hum.Health > 0 then
                                local originalCFrame = hrp.CFrame
                                hrp.CFrame = handle.CFrame * CFrame.new(0, 0, -2)
                                for i = 1, 5 do
                                    if not child.Parent then break end
                                    firetouchinterest(hrp, handle, 0)
                                    task.wait()
                                    firetouchinterest(hrp, handle, 1)
                                    task.wait()
                                end
                                hrp.CFrame = originalCFrame
                            end
                        end
                    end)
                end
            end
        end)
    end
end

