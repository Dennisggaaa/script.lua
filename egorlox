--// RIPPLE
local function ripple(button, position)
    local r = Instance.new("Frame")
    r.BackgroundColor3 = getAccent()
    r.BackgroundTransparency = 0.78
    r.BorderSizePixel = 0
    r.Size = UDim2.fromOffset(8, 8)
    r.AnchorPoint = Vector2.new(0.5, 0.5)
    r.Position = UDim2.fromOffset(
        position.X - button.AbsolutePosition.X,
        position.Y - button.AbsolutePosition.Y
    )
    r.ZIndex = button.ZIndex + 5
    r.Parent = button
    corner(r, 100)

    local target = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.4
    tween(r, 0.42, {
        Size = UDim2.fromOffset(target, target),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Quad)

    task.delay(0.45, function()
        safeDestroy(r)
    end)
end

