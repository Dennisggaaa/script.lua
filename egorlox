-- ══════════════ СТРАНИЦА SS ══════════════
local pSS = NewPage("SS"); Title(pSS, "SS · Style", "Menu color + watermark color")

local function ApplyAccent(col)
    CFG.Accent = col
    if LIVE.MenuStroke then Tw(LIVE.MenuStroke, { Color = col }, 0.2):Play() end
    for _, e in ipairs(LIVE.Accents) do
        pcall(function() Tw(e.o, { [e.p] = col }, 0.2):Play() end)
    end
    for _, t in ipairs(LIVE.Tabs) do
        if t.active then Tw(t.btn, { BackgroundColor3 = col }, 0.2):Play() end
    end
end
local function ApplyWM(col)
    CFG.WMColor = col
    Tw(LIVE.WM.Stroke, { Color = col }, 0.2):Play()
    Tw(LIVE.WM.Dot, { BackgroundColor3 = col }, 0.2):Play()
end

local PALETTE = {
    { "Indigo",  Color3.fromRGB(91, 110, 245) }, { "Cyan",   Color3.fromRGB(57, 211, 224) }, { "Mint",   Color3.fromRGB(78, 204, 163) },
    { "Lime",    Color3.fromRGB(168, 224, 99) }, { "Amber",  Color3.fromRGB(255, 179, 71) }, { "Coral",  Color3.fromRGB(255, 122, 89) },
    { "Rose",    Color3.fromRGB(255, 95, 126) }, { "Purple", Color3.fromRGB(164, 107, 255) }, { "White",  Color3.fromRGB(234, 238, 255) },
}

local function ColorSection(titleTxt, applyFn, getCur)
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 0, 132); wrap.BackgroundColor3 = CFG.Card
    wrap.BorderSizePixel = 0; wrap.Parent = pSS
    Corner(wrap, 10); Stroke(wrap, CFG.Sep, 1)
    Lbl(wrap, titleTxt, UDim2.new(1,-20,0,18), CFG.TxtPri, Enum.Font.GothamBold, 14).Position = UDim2.new(0,14,0,10)

    local preview = Instance.new("Frame")
    preview.Size = UDim2.new(0,26,0,14); preview.Position = UDim2.new(1,-42,0,12)
    preview.BackgroundColor3 = getCur(); preview.BorderSizePixel = 0; preview.Parent = wrap
    Corner(preview, 5)

    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1,-28,0,40); grid.Position = UDim2.new(0,14,0,36)
    grid.BackgroundTransparency = 1; grid.Parent = wrap
    local gl = Instance.new("UIGridLayout")
    gl.CellSize = UDim2.new(0,34,0,34); gl.CellPadding = UDim2.new(0,8,0,8); gl.Parent = grid

    for _, c in ipairs(PALETTE) do
        local sw = Instance.new("TextButton")
        sw.BackgroundColor3 = c; sw.Text = ""; sw.AutoButtonColor = false
        sw.BorderSizePixel = 0; sw.Parent = grid
        Corner(sw, 8); Stroke(sw, CFG.Sep, 1)
        sw.MouseButton1Click:Connect(function()
            applyFn(c); preview.BackgroundColor3 = c
        end)
    end

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1,-28,0,28); box.Position = UDim2.new(0,14,0,92)
    box.BackgroundColor3 = CFG.Panel; box.BorderSizePixel = 0
    box.PlaceholderText = "HEX (#5B6EF5)"; box.Text = ""
    box.TextColor3 = CFG.TxtPri; box.PlaceholderColor3 = CFG.TxtMut
    box.Font = Enum.Font.Gotham; box.TextSize = 12; box.ClearTextOnFocus = false
    box.Parent = wrap
    Corner(box, 7); Stroke(box, CFG.Sep, 1)
    box.FocusLost:Connect(function()
        local t = box.Text:gsub("%s","")
        if t:sub(1,1) ~= "#" then t = "#"..t end
        local r = tonumber(t:sub(2,3), 16)
        local g = tonumber(t:sub(4,5), 16)
        local b = tonumber(t:sub(6,7), 16)
        if r and g and b then
            local col = Color3.fromRGB(r, g, b)
            applyFn(col); preview.BackgroundColor3 = col; box.Text = t:upper()
        else
            box.Text = ""
        end
    end)
end

ColorSection("Menu Color", ApplyAccent, function() return CFG.Accent end)
ColorSection("Watermark Color", ApplyWM, function() return CFG.WMColor end)

