local function CreateTrail(parentFrame, position, size, color)
    local trail = Instance.new("Frame")
    trail.Size = size
    trail.Position = UDim2.new(0, position.X, 0, position.Y)
    trail.BackgroundColor3 = color
    trail.BackgroundTransparency = 0.55
    trail.BorderSizePixel = 0
    trail.Parent = parentFrame
    trail.ZIndex = 1

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = trail

    local tweenInfo = TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeTween = TweenService:Create(trail, tweenInfo, {BackgroundTransparency = 1})
    fadeTween:Play()

    fadeTween.Completed:Connect(function()
        pcall(function() trail:Destroy() end)
    end)
end

