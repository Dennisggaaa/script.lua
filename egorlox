-- Утилита Drag (заточена под тач)
local DragHandler = {}
DragHandler.__index = DragHandler

function DragHandler.new(frame, leaveTrail)
    local self = setmetatable({}, DragHandler)
    self.Frame = frame
    self.Dragging = false
    self.MouseOffset = nil
    self.LeaveTrail = leaveTrail or false
    self.TrailObjects = {}
    self.LastPosition = nil
    self:Initialize()
    return self
end

function DragHandler:Initialize()
    self.Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            self.Dragging = true
            self.MouseOffset = Vector2.new(input.Position.X, input.Position.Y) - self.Frame.AbsolutePosition
            self.LastPosition = self.Frame.AbsolutePosition
        end
    end)

    self.Frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            self.Dragging = false
            if self.LeaveTrail and self.LastPosition then
                self:CreateTrail()
            end
        end
    end)
end

function DragHandler:Update()
    if self.Dragging then
        local touchPos = UserInputService:GetMouseLocation()
        self.Frame.Position = UDim2.new(0, touchPos.X - self.MouseOffset.X, 0, touchPos.Y - self.MouseOffset.Y)
        self.LastPosition = self.Frame.AbsolutePosition
    end
end

function DragHandler:CreateTrail()
    if not self.LeaveTrail or not self.LastPosition then return end

    local trail = Instance.new("Frame")
    trail.Size = self.Frame.Size
    trail.Position = UDim2.new(0, self.LastPosition.X, 0, self.LastPosition.Y)
    trail.BackgroundColor3 = self.Frame.BackgroundColor3
    trail.BackgroundTransparency = 0.6
    trail.BorderSizePixel = 0
    trail.Parent = self.Frame.Parent
    trail.ZIndex = self.Frame.ZIndex - 1

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = trail

    table.insert(self.TrailObjects, trail)

    local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeTween = TweenService:Create(trail, tweenInfo, {BackgroundTransparency = 1})
    fadeTween:Play()

    fadeTween.Completed:Connect(function()
        trail:Destroy()
        table.remove(self.TrailObjects, table.find(self.TrailObjects, trail))
    end)
end

-- Цветовая палитра (оптимизирована под тач)
local ColorPicker = {}
