            TweenService:Create(wm.OuterGlow2, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.92, Size = UDim2.new(1, 22, 1, 22), Position = UDim2.new(0, -11, 0, -11)
            }):Play()
            wait(1.5)
        end
    end)

    spawn(function()
        local angle = 0
        while wm.StarIcon and wm.StarIcon.Parent do
            angle = angle + 0.5
            wm.StarIcon.Rotation = angle
            wm.StarGlow.Rotation = -angle * 0.4
            wm.StarGlow2.Rotation = angle * 0.3
            wait(0.03)
        end
    end)

    spawn(function()
        while wm.StarGlow and wm.StarGlow.Parent do
            TweenService:Create(wm.StarGlow, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0, 52, 0, 52), Position = UDim2.new(0, 17, 0.5, -26), BackgroundTransparency = 0.8
            }):Play()
            TweenService:Create(wm.StarGlow2, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0, 66, 0, 66), Position = UDim2.new(0, 10, 0.5, -33), BackgroundTransparency = 0.88
            }):Play()
            wait(1.2)
            TweenService:Create(wm.StarGlow, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0, 46, 0, 46), Position = UDim2.new(0, 20, 0.5, -23), BackgroundTransparency = 0.85
            }):Play()
