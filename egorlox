-- LOGIC & TABS
local Tabs = {} local ActiveTab = nil
local function SelectTab(name)
    for _, child in ipairs(PageContainer:GetChildren()) do if child:IsA("GuiObject") and not child:IsA("UIListLayout") then child:Destroy() end end
    for tabName, tabData in pairs(Tabs) do
        if tabName == name then
            TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Hover}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.3), {TextColor3 = Theme.Accent}):Play()
            SlideIndicator.Visible = true
            TweenService:Create(SlideIndicator, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 15, 0, tabData.Button.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y + 10)}):Play()
        else
            TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Element}):Play()
            TweenService:Create(tabData.Button.Title, TweenInfo.new(0.3), {TextColor3 = Theme.Text}):Play()
        end
    end
    PageTitle.Text = name ActiveTab = name
    if Tabs[name].Render then Tabs[name].Render() end
end

local function CreateTab(name)
    local Btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Element, AutoButtonColor = false, Text = "", Parent = TabContainer})
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Btn})
    local Title = Create("TextLabel", {Name = "Title", Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 15, 0, 0), BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn})
    Btn.MouseEnter:Connect(function() if ActiveTab ~= name then TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play() end end)
    Btn.MouseLeave:Connect(function() if ActiveTab ~= name then TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Element}):Play() end end)
    Tabs[name] = {Button = Btn, Render = nil}
    Btn.MouseButton1Click:Connect(function() SelectTab(name) end)
    return PageContainer
end

