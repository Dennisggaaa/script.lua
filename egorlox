local notifStack = {}
local NOTIF_H    = 50
local NOTIF_GAP  = 8

local function notify(text, kind)
    -- kind: "error" | "success" | "info"
    local borderCol = ({
        error   = Color3.fromRGB(255, 55, 55),
        success = Color3.fromRGB(60, 220, 100),
        info    = Config.AccentColor,
    })[kind] or Config.AccentColor

    local slot = #notifStack + 1
    local baseY = -(slot * (NOTIF_H + NOTIF_GAP))

    local frame = Instance.new("Frame")
    frame.Size                  = UDim2.new(0, 260, 0, NOTIF_H)
    frame.Position              = UDim2.new(1, 20, 1, baseY)
    frame.BackgroundColor3      = Color3.fromRGB(14, 14, 18)
    frame.BorderSizePixel       = 0
    frame.ZIndex                = 300
    frame.Parent                = Root

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color     = borderCol
    stroke.Thickness = 1.5

    local lbl = Instance.new("TextLabel", frame)
    lbl.Size                  = UDim2.new(1, -20, 1, 0)
    lbl.Position              = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency= 1
    lbl.Text                  = text
    lbl.TextColor3            = Color3.fromRGB(215, 215, 215)
    lbl.TextSize              = 12
    lbl.Font                  = Enum.Font.GothamMedium
    lbl.TextXAlignment        = Enum.TextXAlignment.Left
    lbl.TextWrapped           = true
    lbl.ZIndex                = 301

    table.insert(notifStack, frame)

    -- Slide in
    TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -274, 1, baseY)
    }):Play()

    task.spawn(function()
        task.wait(3)
        local out = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 1, baseY)
        })
        out:Play()
        out.Completed:Wait()
        local idx = table.find(notifStack, frame)
        if idx then table.remove(notifStack, idx) end
        frame:Destroy()
    end)
end

