--// MM2 Функции определения ролей
function MM2_DetectRoles()
    local roles = {}
    local roleFolder = Workspace:FindFirstChild("Roles") or Workspace:FindFirstChild("PlayerRoles")
    
    -- Метод 1: через папку ролей
    if roleFolder then
        for _, player in pairs(Players:GetPlayers()) do
            local playerRole = roleFolder:FindFirstChild(player.Name)
            if playerRole then
                local roleName = playerRole.Value or playerRole.Name
                roles[player.UserId] = roleName
            end
        end
    end
    
    -- Метод 2: через цвета/атрибуты персонажа
    for _, player in pairs(Players:GetPlayers()) do
        if not roles[player.UserId] and player.Character then
            local char = player.Character
            -- Проверка наличия ножа (Murderer)
            local hasKnife = false
            local hasGun = false
            for _, child in pairs(char:GetDescendants()) do
                if child:IsA("Tool") then
                    if child.Name:lower():find("knife") or child.Name:lower():find("blade") or child.Name:lower():find("dagger") then
                        hasKnife = true
                    end
                    if child.Name:lower():find("gun") or child.Name:lower():find("pistol") or child.Name:lower():find("revolver") or child.Name:lower():find("sheriff") then
                        hasGun = true
                    end
                end
            end
            
            if hasKnife then
                roles[player.UserId] = "Murderer"
            elseif hasGun then
                roles[player.UserId] = "Sheriff"
            else
                roles[player.UserId] = "Innocent"
            end
        end
    end
    
    -- Метод 3: через белые/красные части тела
    for _, player in pairs(Players:GetPlayers()) do
        if not roles[player.UserId] and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                -- Проверяем цвет для определения роли
                -- В некоторых версиях MM2 используются цветовые индикаторы
            end
        end
    end
    
    MM2.PlayerRoles = roles
    return roles
end

function MM2_GetPlayerRole(player)
    if MM2.PlayerRoles[player.UserId] then
        return MM2.PlayerRoles[player.UserId]
    end
    return "Unknown"
end

--// MM2 ESP системы
function MM2_CreatePlayerESP(player, role, color)
    local userId = player.UserId
    if MM2.ESPCache[userId] then
        -- Обновляем существующий ESP
        local cache = MM2.ESPCache[userId]
        if cache.billboard then
            cache.billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        end
        return
    end
    
    local char = player.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    -- Создаём BillboardGui для имени и роли
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1000
    billboard.Parent = head
    
    -- Фон
    local bgFrame = Instance.new("Frame")
    bgFrame.Size = UDim2.new(1, 0, 0, 30)
    bgFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bgFrame.BackgroundTransparency = 0.5
    bgFrame.BorderSizePixel = 0
    bgFrame.Parent = billboard
    Instance.new("UICorner", bgFrame).CornerRadius = UDim.new(0, 4)
    
    -- Роль
    local roleLabel = Instance.new("TextLabel")
    roleLabel.Size = UDim2.new(1, 0, 0, 14)
    roleLabel.BackgroundTransparency = 1
    roleLabel.Text = "[" .. role .. "]"
    roleLabel.TextColor3 = color
    roleLabel.Font = Enum.Font.GothamBold
    roleLabel.TextSize = 12
    roleLabel.Parent = bgFrame
    
    -- Имя
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 14)
    nameLabel.Position = UDim2.new(0, 0, 0, 14)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextSize = 11
    nameLabel.Parent = bgFrame
    
    -- Highlight персонажа
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.3
    highlight.Adornee = char
    highlight.Parent = char
    
    -- Чамс (Chams)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local boxHandle = Instance.new("BoxHandleAdornment")
            boxHandle.Size = part.Size
            boxHandle.Adornee = part
            boxHandle.AlwaysOnTop = true
            boxHandle.ZIndex = 5
            boxHandle.Color3 = color
            boxHandle.Transparency = 0.5
            boxHandle.Parent = part
        end
    end
    
    MM2.ESPCache[userId] = {
        billboard = billboard,
        highlight = highlight,
        player = player,
        role = role,
    }
end

function MM2_ClearESP(userId)
    local cache = MM2.ESPCache[userId]
    if cache then
        if cache.billboard then cache.billboard:Destroy() end
        if cache.highlight then cache.highlight:Destroy() end
        MM2.ESPCache[userId] = nil
    end
end

function MM2_ClearAllESP()
    for userId, _ in pairs(MM2.ESPCache) do
        MM2_ClearESP(userId)
    end
end

--// MM2 Системные функции
function MM2_FlingPlayer(player, power, rotation)
    power = power or 1000
    rotation = rotation or Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
    
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        hrp.Velocity = Vector3.new(math.random(-power, power), power, math.random(-power, power))
        hrp.RotVelocity = rotation
        if player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.PlatformStand = true
        end
    end
end

function MM2_KillPlayer(player)
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = 0
    end
end

function MM2_TeleportPlayerToMe(player)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
        end
    end
end

function MM2_FreezePlayer(player)
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
            end
        end
    end
end

function MM2_UnfreezePlayer(player)
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
    end
end

function MM2_InvisiblePlayer(player)
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end
end

function MM2_VisiblePlayer(player)
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 0
            end
        end
    end
end

function MM2_GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if MM2_GetPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

function MM2_GetSheriff()
    for _, player in pairs(Players:GetPlayers()) do
        if MM2_GetPlayerRole(player) == "Sheriff" then
            return player
        end
    end
    return nil
end

function MM2_GetAllInnocents()
    local innocents = {}
    for _, player in pairs(Players:GetPlayers()) do
        if MM2_GetPlayerRole(player) == "Innocent" then
            table.insert(innocents, player)
        end
    end
    return innocents
end

function MM2_GiveKnife(player)
    -- Попытка дать нож через репликацию
    local knifeModel = ReplicatedStorage:FindFirstChild("Knife") or ReplicatedStorage:FindFirstChild("Weapon")
    if knifeModel and player.Character then
        local clone = knifeModel:Clone()
        clone.Parent = player.Character
    end
end

function MM2_StealWeapon(target, weaponType)
    weaponType = weaponType or "Knife"
    if target.Character then
        for _, tool in pairs(target.Character:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find(weaponType:lower()) then
                tool.Parent = LocalPlayer.Character
                return true
            end
        end
    end
    return false
end

