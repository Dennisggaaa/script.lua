--// TOGGLE MENU
local function ToggleMenu()
    CFG.IsOpen = not CFG.IsOpen
    if CFG.IsOpen then
        Tween(Menu, {Position = UDim2.new(0.5, -CFG.Width/2, 0.5, -CFG.Height/2)}, CFG.AnimSpeed, Enum.EasingStyle.Back)
        Tween(WmFrame, {BackgroundTransparency = 0}, 0.3)
        Tween(WmStroke, {Transparency = 0.2}, 0.3)
    else
        Tween(Menu, {Position = UDim2.new(0.5, -CFG.Width/2, 0, -CFG.Height - 100)}, CFG.AnimSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Tween(WmFrame, {BackgroundTransparency = 0}, 0.3)
        Tween(WmStroke, {Transparency = 0.4}, 0.3)
    end
end

WmFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        ToggleMenu()
    end
end)

CloseBtn.MouseButton1Click:Connect(ToggleMenu)

--// DRAG (Header)
local dragging = false
local dragOffset

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local pos = input.Position
        dragOffset = Vector2.new(Menu.AbsolutePosition.X - pos.X, Menu.AbsolutePosition.Y - pos.Y)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and dragOffset and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local newPos = Vector2.new(input.Position.X + dragOffset.X, input.Position.Y + dragOffset.Y)
        Menu.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

