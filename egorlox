local function AddFireButton()
    if FireButton then return end
    FireButton = Instance.new("TextButton")
    FireButton.Size = FireBtnSize
    FireButton.Position = FireBtnPos
    FireButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    FireButton.BackgroundTransparency = 0.3
    FireButton.Text = ""
    FireButton.AutoButtonColor = false
    FireButton.Parent = ScreenGui
    Instance.new("UICorner", FireButton).CornerRadius = UDim.new(1, 0)
    
    FireButton.InputBegan:Connect(function(input)
        if isCustomizing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            isDraggingMarker = true dragStart = input.Position startPos = FireButton.Position
        end
    end)
    FireButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingMarker = false
        end
    end)
end

local function RemoveFireButton()
    if FireButton then FireButton:Destroy() FireButton = nil end
    cachedGameFireBtn = nil
end

UserInputService.InputChanged:Connect(function(input)
    if isDraggingMarker and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        FireButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        FireBtnPos = FireButton.Position
    end
end)

